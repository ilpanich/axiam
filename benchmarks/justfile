# AXIAM benchmark commands. Run from the benchmarks/ directory: `just -f justfile <cmd>`
# or add `mod benchmarks` to the root justfile. Most commands take target= and profile=.
#
# NOTE: `just` only treats `name=value` as a variable override when it comes
# BEFORE the recipe name — placed after, it is parsed as another recipe to run
# (failing with "justfile does not contain recipe `target=…`"). So put the
# assignments first:
#
#   just target=axiam profile=p2-tls13 bench-up
#   just target=axiam bench-seed
#   just target=axiam profile=p2-tls13 bench-run
#   just bench-report
#   just targets="axiam keycloak" profiles="p0-plaintext p2-tls13 p3-mtls" bench-matrix
#
# Before committing hours to a matrix, rehearse it in minutes — same cells, same
# bring-up/seed/run/tear-down path, measurement window collapsed to seconds:
#
#   just targets="axiam keycloak zitadel" profiles="p0-plaintext p2-tls13" bench-dry-run

set shell := ["bash", "-uc"]

target := "axiam"
profile := "p0-plaintext"
# "all", or one scenario. M1: the `.js` is optional — run-benchmark.sh
# normalizes `scenario=authz_check_rest` to `authz_check_rest.js` before the
# AXIAM-only/OAuth2/pending filters run, so both spellings are the same cell.
scenario := "all"
sdk := "python"
# I19: optional JSON override for `rl-prod-check`'s configured-limit table
# (e.g. a gateway/mesh preset's numbers instead of the shipped `internet`
# defaults it reads by default). Empty means "use the read-only extracted
# defaults unmodified".
configured := ""
targets := "axiam keycloak"
profiles := "p0-plaintext p2-tls13"
# build=1 forces a local source build of the AXIAM image; default (0) uses the
# published ghcr image (BENCH_AXIAM_IMAGE), falling back to a build if it can't
# be pulled. Competitors are always prebuilt images.
build := "0"
# rl selects the AXIAM rate-limit posture for the run:
#   neutralized (default) — limits raised to ~unlimited so k6's single source IP
#                           measures endpoint capacity, not the per-IP limiter.
#   prod                  — the server's production defaults (per-IP limiter
#                           ACTIVE). Head-to-head numbers taken this way are NOT
#                           comparable to competitors and report.py will flag them.
rl := "neutralized"
# dbcaps selects the datastore's CPU/mem envelope (C2):
#   capped (default) — the standard envelope, same as every other container
#                       (BENCH_DB_CPUS/BENCH_DB_MEM defaults in each target's
#                       docker-compose.yml, normally 2 CPUs / 1024 MiB).
#   uncapped          — raises the datastore to 4 CPUs / 2048 MiB so a run can
#                       show whether the datastore — not the server — is the
#                       ceiling. BENCH_DB_CPUS/BENCH_DB_MEM are already
#                       env-driven in every target's compose file; this just
#                       wires the two values through. An operator-supplied
#                       BENCH_DB_CPUS/BENCH_DB_MEM still wins over either mode.
dbcaps := "capped"
# repeat controls how many times `bench-matrix` runs the whole target×profile
# ×scenario matrix (C1: median-of-N). Each pass writes into its own
# results/run-<i>/ subtree (same flat per-cell layout underneath), and
# `bench-report`/`report.py` auto-detect the results/run-*/ layout and median
# every metric per cell across the valid runs. Set repeat=1 for a quick single
# pass (still lands under results/run-1/).
repeat := "3"
# dry=1 turns `bench-run` into a DRY RUN: the same profile env, seed env,
# scenario filter and k6 invocation as a real cell, but with the measured
# window collapsed to a few seconds and the verdict based on whether the k6
# client could connect, send its request and get the expected answer — not on
# how fast it was. Results land under results/dry-run/ so they never mix into
# what `bench-report` aggregates. `bench-dry-run` (below) applies this across
# the whole target x profile matrix. See runner/run-benchmark.sh's `--dry-run`
# block for the exact knobs (BENCH_DRY_VUS / BENCH_DRY_DURATION / ...).
dry := "0"
# E3: fixture-size multiplier for `bench-bulk-seed` (see that recipe).
scale := "10"

# Generate throwaway TLS/mTLS certs for the security profiles (idempotent).
bench-certs:
    bash runner/gen-certs.sh

# Bring a target up under a security profile (adds TLS edge for p1/p2/p3).
bench-up:
    #!/usr/bin/env bash
    set -euo pipefail
    source profiles/{{profile}}.env
    COMPOSE="targets/{{target}}/docker-compose.yml"

    # --- AXIAM target: secrets + image selection (competitors need neither) ---
    if [ "{{target}}" = "axiam" ]; then
      # User-provided secrets win if present (real deployment creds/keys).
      [ -f ../docker/.secrets/env ] && source ../docker/.secrets/env || true
      # Otherwise bootstrap STABLE, throwaway, local-only bench secrets so the
      # compose file's required vars resolve — mirrors `just prod-up`'s JWT keygen.
      # Stable (not random) so a persisted DB volume still authenticates on re-run.
      SECRETS_DIR="../docker/.secrets"
      PRIV="$SECRETS_DIR/jwt_ed25519.pem"; PUB="$SECRETS_DIR/jwt_ed25519.pub.pem"
      if [ ! -f "$PRIV" ] || [ ! -f "$PUB" ]; then
        command -v openssl >/dev/null || { echo "[bench-up] openssl is required to generate the JWT keypair"; exit 1; }
        echo "[bench-up] generating throwaway Ed25519 JWT keypair under docker/.secrets/ (first run)"
        mkdir -p "$SECRETS_DIR"
        openssl genpkey -algorithm ed25519 -out "$PRIV"
        openssl pkey -in "$PRIV" -pubout -out "$PUB"
        chmod 600 "$PRIV"
      fi
      export AXIAM__AUTH__JWT_PRIVATE_KEY_PEM="${AXIAM__AUTH__JWT_PRIVATE_KEY_PEM:-$(cat "$PRIV")}"
      export AXIAM__AUTH__JWT_PUBLIC_KEY_PEM="${AXIAM__AUTH__JWT_PUBLIC_KEY_PEM:-$(cat "$PUB")}"
      # Stable local hex-secret helper: generate once, reuse across runs so a
      # persisted DB volume and previously-encrypted data stay decryptable.
      genhex() { local f="$SECRETS_DIR/$1"; [ -f "$f" ] || { openssl rand -hex 32 > "$f"; chmod 600 "$f"; }; cat "$f"; }
      # AMQP master signing key (SECHRD-08 / D-05c) — mandatory at startup in the
      # release image (there is no unsigned code path).
      export AXIAM__AMQP__SIGNING_KEY="${AXIAM__AMQP__SIGNING_KEY:-$(genhex amqp_signing.hex)}"
      # Optional subsystem secrets — set so MFA, GDPR pseudonymization, email/GDPR
      # export, the password pepper, and OIDC discovery are all functional rather
      # than degraded-off (D-02 / REQ-14). The encryption keys/pepper are 64-hex
      # (32-byte AES-256-GCM / HMAC); AXIAM__AUTH__PEPPER is a plain string; the
      # OIDC issuer must be https or localhost.
      export AXIAM__AUTH__MFA_ENCRYPTION_KEY="${AXIAM__AUTH__MFA_ENCRYPTION_KEY:-$(genhex mfa_enc.hex)}"
      export AXIAM__EMAIL_ENCRYPTION_KEY="${AXIAM__EMAIL_ENCRYPTION_KEY:-$(genhex email_enc.hex)}"
      export AXIAM__GDPR_PSEUDONYM_PEPPER="${AXIAM__GDPR_PSEUDONYM_PEPPER:-$(genhex gdpr_pepper.hex)}"
      export AXIAM__AUTH__PEPPER="${AXIAM__AUTH__PEPPER:-$(genhex auth_pepper.hex)}"
      export AXIAM__AUTH__OAUTH2_ISSUER_URL="${AXIAM__AUTH__OAUTH2_ISSUER_URL:-${BENCH_ISSUER_URL:-http://localhost:${BENCH_APP_PORT:-8090}}}"
      export AXIAM__DB__USERNAME="${AXIAM__DB__USERNAME:-bench}"
      export AXIAM__DB__PASSWORD="${AXIAM__DB__PASSWORD:-bench-local-only-pw}"
      export RABBITMQ_DEFAULT_USER="${RABBITMQ_DEFAULT_USER:-bench}"
      export RABBITMQ_DEFAULT_PASS="${RABBITMQ_DEFAULT_PASS:-bench-local-only-pw}"
      # Rate-limit posture (see `rl` at the top of this file). Neutralized is the
      # default so a single-IP k6 run measures endpoint capacity. The prod values
      # mirror the server defaults in crates/axiam-api-rest/src/config/rate_limit.rs
      # and crates/axiam-api-grpc/src/config.rs — keep them in sync if those change.
      export AXIAM_BENCH_RL_POSTURE="{{rl}}"
      if [ "{{rl}}" = "prod" ]; then
        echo "[bench-up] rate limits: PRODUCTION posture — per-IP limiter ACTIVE (head-to-head numbers will be throttled and flagged by report.py)"
        # Human endpoints — unchanged by I3, and never sized from capacity.
        export AXIAM__RATE_LIMIT__LOGIN_PER_MIN=10
        export AXIAM__RATE_LIMIT__REGISTER_PER_MIN=5
        export AXIAM__RATE_LIMIT__PASSWORD_RESET_PER_MIN=3
        export AXIAM__RATE_LIMIT__MFA_PER_MIN=5
        # Machine endpoints — I3 revision. Previous values, for the record:
        # token 20, introspect 10, revoke 10, authz_check 300. If these drift
        # from RateLimitConfig::default() again, `just rl-prod-check` FAILS the
        # run: it extracts the real numbers from the source and compares them
        # against what was admitted, so a stale value here shows up as every
        # endpoint being "throttled" against a limit the server never had.
        export AXIAM__RATE_LIMIT__TOKEN_PER_MIN=120
        export AXIAM__RATE_LIMIT__INTROSPECT_PER_MIN=600
        export AXIAM__RATE_LIMIT__REVOKE_PER_MIN=60
        export AXIAM__RATE_LIMIT__AUTHZ_CHECK_PER_MIN=1800
        # gRPC is per-method-family since I2. Leaving identity/admin unset
        # would let them derive inside the server, which is the shipped
        # behaviour — but pinning them makes the posture the harness applied
        # explicit in `docker inspect`, so rl-prod-check can assert each family
        # separately (a server-wide assertion would not have caught I2).
        #
        # These MUST mirror the server's own derivation or `rl=prod` measures a
        # posture the product does not ship:
        #   authz    = default_grpc_authz_per_sec()            = 100/s
        #   identity = authz x IDENTITY_PER_SEC_MULTIPLE (5)   = 500/s
        #   admin    = ADMIN_PER_SEC_DEFAULT                   =  10/s
        # admin is an ABSOLUTE constant, NOT 1x authz — SEC-079 decoupled it so
        # widening the mesh authz ceiling can never widen the administrative
        # one. This line said 100 (the old 1:1 ratio), which pinned admin TEN
        # TIMES above the shipped ceiling and made every rl=prod admin figure
        # measure a posture no deployment runs.
        #
        # The fourth family (Infra: reflection + health) takes the fixed
        # INFRA_PER_SEC and is deliberately NOT settable per instance, so there
        # is no env var to pin here.
        export AXIAM__GRPC__GRPC_AUTHZ_PER_SEC=100
        export AXIAM__GRPC__GRPC_IDENTITY_PER_SEC=500
        export AXIAM__GRPC__GRPC_ADMIN_PER_SEC=10
      elif [ "{{rl}}" != "neutralized" ]; then
        echo "[bench-up] unknown rl='{{rl}}' (use rl=neutralized or rl=prod)" >&2; exit 1
      else
        echo "[bench-up] rate limits: NEUTRALIZED (compose defaults ~unlimited)"
      fi
      # H6 (fixes H2 §8.3): on an http:// baseline the server's production-correct
      # `Secure` session cookies are unusable by k6's cookie jar, so every
      # login-based scenario dies in setup(). Turn the attribute off for
      # p0-plaintext ONLY — every TLS profile keeps the shipped default. An
      # operator-set BENCH_AXIAM_COOKIE_SECURE still wins (e.g. to reproduce the
      # broken behaviour deliberately).
      if [ "{{profile}}" = "p0-plaintext" ]; then
        export BENCH_AXIAM_COOKIE_SECURE="${BENCH_AXIAM_COOKIE_SECURE:-false}"
        echo "[bench-up] p0-plaintext: AXIAM__AUTH__COOKIE_SECURE=${BENCH_AXIAM_COOKIE_SECURE} (k6's jar cannot replay Secure cookies over http://)"
      fi
      # J9/E1: RUST_LOG is what decides whether the server emits the
      # `axiam::perf` stage-timing events an investigation pass reads. It is
      # already wired through targets/axiam/docker-compose.yml, but run 5's I5
      # pass still produced empty logs because the variable was exported for
      # `bench-run` — long after `bench-up` had baked the container's
      # environment (PRIVATE_BENCH_ANALYSIS.md §2.6). Setting it here, loudly,
      # makes the value that actually lands in the container part of the
      # bring-up record; run-benchmark.sh's BENCH_REQUIRE_ENV preflight then
      # verifies it off `docker inspect` before spending any k6 time.
      export RUST_LOG="${RUST_LOG:-axiam=warn}"
      echo "[bench-up] RUST_LOG=$RUST_LOG (stage timings need axiam=debug — set it HERE, on bench-up, not on bench-run)"
      # Default the prebuilt image tag to the workspace version so it tracks
      # releases automatically (override with BENCH_AXIAM_IMAGE).
      if [ -z "${BENCH_AXIAM_IMAGE:-}" ]; then
        VER="$(grep -m1 '^version' ../Cargo.toml | cut -d'"' -f2)"
        export BENCH_AXIAM_IMAGE="ghcr.io/ilpanich/axiam/server:${VER}"
      fi
    fi

    # DB CPU/mem envelope (C2, all targets — see `dbcaps` at the top of this
    # file). BENCH_DB_CPUS/BENCH_DB_MEM are already read directly by every
    # target's docker-compose.yml (surrealdb/postgres `cpus:`/`mem_limit:`),
    # so this only needs to set the two env vars before `docker compose up`;
    # an operator-supplied BENCH_DB_CPUS/BENCH_DB_MEM still wins. The chosen
    # values are recorded in meta.json automatically — run-benchmark.sh reads
    # each container's actual cpu/mem cap straight off `docker inspect`
    # (HostConfig.NanoCpus/Memory) rather than trusting this shell's env, so a
    # separate `bench-run` invocation still captures whatever cap the running
    # DB container was actually started with.
    if [ "{{dbcaps}}" = "uncapped" ]; then
      export BENCH_DB_CPUS="${BENCH_DB_CPUS:-4}"
      export BENCH_DB_MEM="${BENCH_DB_MEM:-2048m}"
      echo "[bench-up] DB caps: UNCAPPED (${BENCH_DB_CPUS} CPUs / ${BENCH_DB_MEM}) — measuring the server ceiling, not the datastore's"
    elif [ "{{dbcaps}}" != "capped" ]; then
      echo "[bench-up] unknown dbcaps='{{dbcaps}}' (use dbcaps=capped or dbcaps=uncapped)" >&2; exit 1
    fi

    PROFILE_ARG=""
    OVERRIDE_ARG=""
    if [ "{{profile}}" != "p0-plaintext" ]; then
      # Both targets need the throwaway server/CA certs for TLS profiles: AXIAM
      # fronts them with an nginx edge, Keycloak terminates TLS in-process from
      # the same /certs mount. (mkcert-style material; profiles/certs is gitignored.)
      just bench-certs
    fi
    if [ "{{profile}}" != "p0-plaintext" ] && [ "{{target}}" = "axiam" ]; then
      if [ "{{profile}}" = "p2-tls13" ] && [ -n "${BENCH_NGINX_CONF:-}" ]; then
        # B2 isolation cell: an operator-set BENCH_NGINX_CONF (tls13-h1.conf)
        # forces the nginx-fronted p2 path instead of the native rustls
        # listener, giving a TLS 1.3 + HTTP/1.1-only edge to isolate the
        # h2-vs-h1.1 effect. See targets/axiam/tls/tls13-h1.conf. Invoke as:
        #   BENCH_NGINX_CONF=tls13-h1.conf just target=axiam profile=p2-tls13 bench-up
        PROFILE_ARG="--profile tls"
      elif [ "{{profile}}" = "p2-tls13" ]; then
        # p2 = TLS 1.3, server-auth: exactly what AXIAM's native rustls listener
        # does, so terminate in-process (no nginx) to measure AXIAM's own TLS
        # stack inside its CPU cap — comparable to keycloak/zitadel native TLS.
        # See targets/axiam/docker-compose.native-tls.yml.
        OVERRIDE_ARG="-f targets/axiam/docker-compose.native-tls.yml"
      elif [ "{{profile}}" = "p3-mtls" ]; then
        # p3 = TLS 1.3 + X.509 client-cert auth. AXIAM now verifies client certs
        # in-process (D3: rustls WebPkiClientVerifier over profiles/certs/ca.crt),
        # so terminate mTLS natively — no nginx edge — making the VERIFIED peer
        # cert the identity source (not a proxy header) and keeping the crypto
        # inside AXIAM's cap. Layers the mTLS overlay on top of the native-TLS
        # one (same pattern p2 used in 649798e).
        OVERRIDE_ARG="-f targets/axiam/docker-compose.native-tls.yml -f targets/axiam/docker-compose.native-mtls.yml"
      else
        # p1-tls12: the native stack is TLS 1.3-only by policy and can't do
        # TLS 1.2, so keep the nginx edge for that profile (see docs/security-profiles.md).
        case "{{profile}}" in
          p1-tls12) export BENCH_NGINX_CONF=tls12.conf ;;
        esac
        PROFILE_ARG="--profile tls"
      fi
    fi
    # Zitadel terminates TLS in-process (tlsMode=enabled) for the https profiles,
    # serving HTTPS+h2 on its port with the shared throwaway cert. TLS 1.2-vs-1.3
    # and mTLS are not separately tunable in Zitadel's built-in listener, so p1/p2
    # both use its default modern TLS; p3-mtls has no client-cert story here.
    if [ "{{profile}}" != "p0-plaintext" ] && [ "{{target}}" = "zitadel" ]; then
      export BENCH_ZITADEL_TLS_MODE=enabled
      export BENCH_ZITADEL_EXTERNAL_SECURE=true
      export BENCH_ZITADEL_TLS_ENABLED=true
      export BENCH_ZITADEL_TLS_CERTPATH=/certs/server.crt
      export BENCH_ZITADEL_TLS_KEYPATH=/certs/server.key
      if [ "{{profile}}" = "p3-mtls" ]; then
        echo "[bench-up] NOTE: Zitadel's built-in TLS has no mTLS/client-cert mode;" >&2
        echo "           running p3 as server-TLS only for zitadel." >&2
      fi
    fi

    BUILD_ARG=""
    if [ "{{build}}" = "1" ] && [ "{{target}}" = "axiam" ]; then
      BUILD_ARG="--build"          # force a local source build of the AXIAM image
    elif [ "{{target}}" = "axiam" ]; then
      # Default: fetch the prebuilt server image so no source build is needed.
      if ! docker compose -f "$COMPOSE" pull axiam-server 2>/dev/null; then
        echo "[bench-up] could not pull $BENCH_AXIAM_IMAGE."
        echo "           GHCR packages are private by default and per-tag images may not"
        echo "           be published, so an unauthenticated pull is denied. To use the"
        echo "           prebuilt image: 'docker login ghcr.io' with a PAT that can read"
        echo "           the package, or set BENCH_AXIAM_IMAGE to an image you can pull."
        echo "           Falling back to a local source build now (same as build=1)."
        BUILD_ARG="--build"
      fi
    fi

    # --- Port pre-flight -------------------------------------------------------
    # Fail fast with an actionable message if a host port we're about to publish
    # is already taken — otherwise docker dies with a cryptic "bind: address
    # already in use" (or, for a port docker doesn't publish, the readiness gate
    # just times out after 180s). Common culprit: a dev service (e.g. sage-gui)
    # holding 8443, the default BENCH_TLS_PORT.
    #
    # The holder being THIS target's own stack is not a conflict: `docker
    # compose up` stops the old container before rebinding, so recreating it
    # under a different overlay works fine. Refusing there made switching
    # profiles impossible without a manual `bench-down` — and since the same
    # guard fires on the p0 -> p2/p3 move, the operator's natural next step was
    # to bench the new profile against the OLD listener, which is precisely
    # the failure `sdk/_preflight.sh` now catches on the other side.
    # The compose project name (docker's `label=com.docker.compose.project`)
    # comes from the compose file's top-level `name:` key — read it from there
    # rather than hardcoding, so a rename cannot silently turn this check into
    # a no-op that resurrects the old refuse-to-switch behaviour.
    COMPOSE_PROJECT="$(sed -n 's/^name:[[:space:]]*//p' "$COMPOSE" | head -1)"
    COMPOSE_PROJECT="${COMPOSE_PROJECT:-bench-{{target}}}"
    port_held_by_own_stack() {
      docker ps --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" \
        --format '{{{{.Ports}}}}' 2>/dev/null | grep -q ":$1->"
    }
    check_port() {
      if timeout 2 bash -c "exec 3<>/dev/tcp/127.0.0.1/$1" 2>/dev/null; then
        if port_held_by_own_stack "$1"; then
          echo "[bench-up] port $1 ($2) is held by this target's own running stack — recreating it."
          return 0
        fi
        echo "[bench-up] port $1 ($2) is already in use on 127.0.0.1." >&2
        echo "           Free it, or override the port, e.g.:" >&2
        echo "             BENCH_TLS_PORT=18443 just target={{target}} profile={{profile}} bench-up" >&2
        return 1
      fi
    }
    port_conflict=0
    if [ "{{target}}" = "axiam" ] && [ -n "$OVERRIDE_ARG" ]; then
      # Native TLS/mTLS (p2-tls13, p3-mtls): the server publishes the TLS port
      # (+ grpc); no plaintext 8090. Detected via the native compose override.
      check_port "${BENCH_TLS_PORT:-8443}" "TLS / BENCH_TLS_PORT" || port_conflict=1
    else
      check_port "${BENCH_APP_PORT:-8090}" "app / BENCH_APP_PORT" || port_conflict=1
      # Targets that also publish the TLS port: keycloak always; axiam with its edge.
      if [ "{{target}}" = "keycloak" ] || { [ "{{target}}" = "axiam" ] && [ -n "$PROFILE_ARG" ]; }; then
        check_port "${BENCH_TLS_PORT:-8443}" "TLS / BENCH_TLS_PORT" || port_conflict=1
      fi
    fi
    [ "$port_conflict" -eq 0 ] || exit 1

    # The diagnostic dump is on THIS path too, not just the readiness timeout
    # below. `up --wait` fails fast when a container exits during startup, and
    # that — a rejected config, a missing secret, a failed validate() — is the
    # most common way a cell dies. It printed one line ("container
    # bench-axiam-server exited (101)") and nothing else, while bench-dry-run's
    # ledger promised "see the compose ps+logs dumped above". Diagnosing the
    # alpha25 device-flow cell meant re-running bench-up by hand and reaching
    # for `docker logs` to find the panic that had already happened twice.
    if ! docker compose -f "$COMPOSE" $OVERRIDE_ARG $PROFILE_ARG up -d --wait $BUILD_ARG; then
      echo "[bench-up] FAILED: a container did not start (see its last lines below)" >&2
      docker compose -f "$COMPOSE" $PROFILE_ARG ps -a >&2 || true
      docker compose -f "$COMPOSE" $PROFILE_ARG logs --tail 40 >&2 || true
      exit 1
    fi

    # --- Readiness gate --------------------------------------------------------
    # `up -d --wait` only blocks until each container is *running* (or, if it has
    # one, healthcheck-healthy). The zitadel/keycloak services declare no app-level
    # healthcheck, so --wait returns while the server is still running migrations /
    # `start-from-init`. The published port is already bound by docker-proxy, so a
    # too-early request is ACCEPTED and then RST — surfacing to k6 as
    # "connection reset by peer" on e.g. GET /oauth/v2/keys a couple of seconds in.
    # Gate on the target's real HTTP readiness at the EXACT scheme/host/port k6 will
    # hit (BENCH_SCHEME/BENCH_PORT come from the profile env sourced above), so
    # neither seeding nor the k6 run can start against a not-yet-serving target.
    READY_HOST="${BENCH_HOST:-localhost}"
    READY_PORT="${BENCH_PORT:-${BENCH_APP_PORT:-8090}}"
    READY_BASE="${BENCH_SCHEME:-http}://${READY_HOST}:${READY_PORT}"
    case "{{target}}" in
      zitadel)  READY_URL="$READY_BASE/debug/ready" ;;    # 200 only when fully initialized
      keycloak) READY_URL="$READY_BASE/realms/master" ;;  # 200 once the server serves
      *)        READY_URL="$READY_BASE/health" ;;         # axiam liveness/readiness
    esac
    echo "[bench-up] waiting for {{target}} to serve at $READY_URL (timeout 180s)"
    ready_deadline=$(( $(date +%s) + 180 ))
    # Under p3-mtls the listener may demand a verified client cert (axiam's
    # rustls client_auth=required; keycloak's KC_HTTPS_CLIENT_AUTH=required), so
    # the readiness probe must present one too. BENCH_CLIENT_CERT/KEY come from
    # the sourced profile env.
    #
    # Keyed on the PROFILE, never on the target: the old `target = axiam` guard
    # left keycloak/p3-mtls probing an mTLS listener bare-handed, so every
    # attempt was refused at the TLS handshake and the cell burned the full 180s
    # into "TIMEOUT: keycloak did not become ready" — a healthy server misread as
    # a dead one. (It only ever surfaced once the bench-down fix stopped the
    # earlier port conflict from killing that cell first.) Presenting a cert to a
    # target that does not ask for one is free: TLS only sends the client
    # certificate when the server requests it, which is what keeps this correct
    # for zitadel, whose built-in TLS has no client-cert mode at all.
    READY_MTLS=""
    if [ "{{profile}}" = "p3-mtls" ] \
       && [ -n "${BENCH_CLIENT_CERT:-}" ] && [ -n "${BENCH_CLIENT_KEY:-}" ]; then
      READY_MTLS="--cert ${BENCH_CLIENT_CERT} --key ${BENCH_CLIENT_KEY}"
    fi
    # -k: the TLS profiles front a throwaway private CA k6 also can't verify.
    until curl -skf $READY_MTLS -o /dev/null "$READY_URL"; do
      if [ "$(date +%s)" -ge "$ready_deadline" ]; then
        echo "[bench-up] TIMEOUT: {{target}} did not become ready at $READY_URL" >&2
        docker compose -f "$COMPOSE" $PROFILE_ARG ps >&2 || true
        docker compose -f "$COMPOSE" $PROFILE_ARG logs --tail 40 >&2 || true
        exit 1
      fi
      sleep 2
    done
    echo "[bench-up] {{target}} is ready."

# Provision org/tenant/user/client for a target; writes .seed/<target>.seed.env
# (client secrets/passwords — gitignored, kept out of the results/ tree we
# share) and, once the post-seed smoke checks pass, results/<target>.seed.ok
# (a no-secret marker bench-run refuses to start the k6 matrix without).
# Seeding talks to the plaintext app port (:8090) for AXIAM/Keycloak, which keep
# HTTP alongside HTTPS. Zitadel under a TLS profile serves TLS-only, so its seed
# must go over https:<tls-port> — derived from the profile env here and passed as
# the base URL (seed.sh uses curl -k for Zitadel, trusting the throwaway CA).
bench-seed:
    #!/usr/bin/env bash
    set -euo pipefail
    if { [ "{{target}}" = "zitadel" ] && [ "{{profile}}" != "p0-plaintext" ]; } \
       || { [ "{{target}}" = "axiam" ] && { [ "{{profile}}" = "p2-tls13" ] || [ "{{profile}}" = "p3-mtls" ]; }; }; then
      # TLS-only listeners (zitadel built-in TLS; axiam native rustls) have no
      # plaintext side port, so seed over https at the TLS port (seed.sh uses -k).
      # For axiam p3-mtls the native listener also REQUIRES a client cert, so
      # sourcing the profile env exports BENCH_CLIENT_CERT/KEY, which seed.sh
      # presents transparently on every request (see its curl wrapper).
      source profiles/{{profile}}.env
      BASE="${BENCH_SCHEME:-https}://${BENCH_HOST:-localhost}:${BENCH_PORT:-8443}"
      bash runner/seed.sh {{target}} "$BASE"
    else
      bash runner/seed.sh {{target}}
    fi

# E3/J12: inflate the seeded AXIAM fixture to N x scale for the seed-size
# sensitivity cell. Requires the stack up and `bench-seed` done. Writes rows
# straight into SurrealDB in batched transactions (the REST path is fine for
# the functional fixture and hopeless for 100 000 users), leaves the seeded
# benchuser/bench-resource/bench-reader objects untouched so before/after
# numbers compare the same logical query against a bigger index, and records
# the resulting scale in .seed/axiam.bulk.env → every cell's meta.json.
#
#   just scale=10 bench-bulk-seed          # 10 000 users, 2 000 resources
#   just scale=100 bench-bulk-seed         # the 100x cell
#   just bench-bulk-verify                 # row counts only, no writes
#
# Knobs (env): BENCH_SEED_USERS/RESOURCES/ROLES (per-tenant bases before the
# multiplier), BENCH_SEED_TENANTS (extra tenants), BENCH_SEED_DEPTH,
# BENCH_SEED_DENY_RATIO, BENCH_SEED_BATCH.
bench-bulk-seed:
    bash runner/bulk-seed.sh --scale {{scale}}

# Row counts for the tables the bulk seed touches — no writes.
bench-bulk-verify:
    bash runner/bulk-seed.sh --verify-only

# Run the scenario suite (load + resource sampling) for a target/profile.
# G2/H1: run-benchmark.sh gates its first cell behind a post-seed settle check
# (a concurrent burst probe as of H1 — see docs/methodology.md "Post-seed
# settle gate v2") and rotates the scenario order by BENCH_RUN_INDEX (set to
# `i` per repeat pass by bench-matrix below; defaults to 1 — natural order —
# for a manual invocation). Tunables (env, not `just` vars): BENCH_SETTLE
# (default 1, set 0 to skip), BENCH_SETTLE_BURST_VUS (20), BENCH_SETTLE_BURST_SECS
# (15), BENCH_SETTLE_PROBE_THR (400 ops/s), BENCH_SETTLE_PROBE_P50_MS (150),
# BENCH_SETTLE_RETRY_SECS (30), BENCH_SETTLE_TIMEOUT_SECS (600), BENCH_RUN_INDEX
# (1). BENCH_SETTLE_STABLE_SECS/BENCH_SETTLE_MAX_MS were the superseded serial-
# canary knobs and are no longer consulted.
bench-run:
    #!/usr/bin/env bash
    set -euo pipefail
    DRY_ARG=""
    if [ "{{dry}}" = "1" ]; then
      DRY_ARG="--dry-run"
    elif [ "{{dry}}" != "0" ]; then
      echo "[bench-run] unknown dry='{{dry}}' (use dry=0 or dry=1)" >&2; exit 1
    fi
    bash runner/run-benchmark.sh --target {{target}} --profile {{profile}} --scenario {{scenario}} $DRY_ARG

# Tear a target down (and its volumes).
bench-down:
    #!/usr/bin/env bash
    set -euo pipefail
    COMPOSE="targets/{{target}}/docker-compose.yml"
    # `docker compose down` interpolates the ENTIRE compose file, so every
    # required (`${VAR:?…}`) secret must still resolve — even though teardown
    # never uses one. Derive that set FROM the compose file instead of keeping a
    # hand-written copy of it: the old hardcoded list went stale the moment
    # AXIAM__AUTH__PEPPER (OBS-1) became mandatory, so EVERY `bench-down` failed
    # with "required variable … is missing a value", left the stack running, and
    # the leftover listener then failed the NEXT target's port pre-flight
    # ("port 8443 is already in use") — surfacing three cells away from its
    # cause. A real value already in the environment always wins; the `x`
    # placeholder only fills the gaps (competitors ignore these entirely).
    while read -r v; do
      if [ -n "${v:-}" ]; then export "$v=${!v:-x}"; fi
    done < <(grep -oE '\$\{[A-Za-z_][A-Za-z0-9_]*:\?' "$COMPOSE" \
             | sed 's/^\${//; s/:?$//' | sort -u)
    docker compose -f "$COMPOSE" --profile tls down -v || \
      docker compose -f "$COMPOSE" down -v

# Aggregate everything under results/ into results/report.md.
bench-report:
    python3 runner/report.py --results results

# I19 (improvement-after-run4-benchmark.md §D): per-endpoint configured-vs-
# admitted assertions for an `rl=prod` sensitivity pass — automates the
# by-hand k6-summary read that caught I1's gRPC ×60 units bug. Run this
# after a `just rl=prod target=axiam ... bench-run`/`bench-matrix` pass, once
# results for the relevant scenarios exist under the given profile. Exits
# non-zero (and prints which endpoint(s)) if any admission rate is outside
# ±10% of its configured limit. Writes results/rl-prod-summary.md.
# Pass configured=<json> to override a field (e.g. a gateway/mesh preset's
# numbers instead of the shipped `internet` defaults this reads by default).
rl-prod-check:
    #!/usr/bin/env bash
    set -euo pipefail
    ARGS=(--results "${BENCH_RESULTS_DIR:-results}" --target {{target}} --profile {{profile}})
    if [ -n "{{configured}}" ]; then
      ARGS+=(--configured-json '{{configured}}')
    fi
    python3 runner/rl_prod_check.py "${ARGS[@]}"

# Full unattended matrix: every target × profile × scenario, with up/seed/run/down.
# repeat=N (default 3, see `repeat` above): runs the whole matrix N times,
# each pass writing into its own results/run-<i>/ subtree using the SAME flat
# target/profile/scenario layout underneath, so the existing per-cell code
# (seed marker, run-benchmark.sh) is reused unchanged. report.py auto-detects
# the results/run-*/ layout and medians each cell across the valid runs (C1).
# `rl` and `dbcaps` are forwarded to every bench-up so
# `just target=axiam rl=prod bench-matrix` / `just dbcaps=uncapped bench-matrix`
# work end-to-end (not just for a single manual bench-up).
bench-matrix:
    #!/usr/bin/env bash
    set -euo pipefail
    # H1 item 2: nest under whatever BENCH_RESULTS_DIR the CALLER already set
    # (e.g. run-improvement-tasks.sh redirecting a task into its own
    # results/tasks/<task-id>/ subtree), instead of unconditionally
    # overwriting it with "$PWD/results/run-$i" every iteration — that
    # clobber is exactly why g2-verify's mini matrix used to write into the
    # results ROOT (its own SUMMARY checker globs under the task's own dir
    # and correctly reported "no meta.json" for a leak it didn't cause).
    # Captured ONCE, before the loop below starts re-exporting
    # BENCH_RESULTS_DIR per repeat — otherwise run-2 would nest under run-1's
    # directory instead of alongside it. Only when the caller left
    # BENCH_RESULTS_DIR unset do we fall back to the plain results/ root,
    # same as before.
    BASE_RESULTS_DIR="${BENCH_RESULTS_DIR:-$PWD/results}"
    for i in $(seq 1 {{repeat}}); do
      RUN_DIR="$BASE_RESULTS_DIR/run-$i"
      echo "### repeat $i/{{repeat}} -> $RUN_DIR ###"
      mkdir -p "$RUN_DIR"
      export BENCH_RESULTS_DIR="$RUN_DIR"
      # G2 item 2: BENCH_RUN_INDEX drives run-benchmark.sh's cell-order
      # rotation (rotate_scenarios()) — run-1 executes scenarios in their
      # natural order, run-2 starts one scenario further along, etc., so no
      # scenario is systematically first (and therefore corrupted by the
      # post-seed settle window) across the repeat set. See docs/methodology.md
      # "Post-seed settle gate & cell-order rotation".
      export BENCH_RUN_INDEX="$i"
      for t in {{targets}}; do
        for p in {{profiles}}; do
          echo "=== run $i: $t / $p (rl={{rl}} dbcaps={{dbcaps}}) ==="
          just target=$t profile=$p rl={{rl}} dbcaps={{dbcaps}} build={{build}} bench-up
          just target=$t profile=$p bench-seed
          just target=$t profile=$p bench-run
          just target=$t bench-down
        done
      done
    done
    unset BENCH_RESULTS_DIR BENCH_RUN_INDEX
    # H1 item 2 (same clobber family): aggregate from wherever this matrix
    # actually wrote (BASE_RESULTS_DIR), not the hardcoded "results" root —
    # a caller-redirected matrix (e.g. a task's results/tasks/<id>/ subtree)
    # must not spill its report.md into the shared results/ root either.
    python3 runner/report.py --results "$BASE_RESULTS_DIR"

# Rehearse the whole matrix in minutes instead of hours.
#
# Walks the SAME target x profile grid as `bench-matrix`, doing the SAME
# bench-up -> bench-seed -> bench-run -> bench-down for each cell, but with
# `dry=1`: every scenario still runs — real profile env, real seed env, real
# k6 client, real samplers — with the measured window collapsed to a few
# seconds. Each cell is graded on the CLIENT CONTRACT (did k6 connect, send its
# request, and get back the answer the scenario expects) rather than on
# throughput, so an hour-deep break — a Keycloak realm that seeds but rejects
# the client, a Zitadel that comes up too slowly, a p3-mtls cert k6 can't load,
# a gRPC dial into a TLS listener, an OAuth2 cell that would be silently
# skipped — surfaces before you commit to the real run.
#
# Unlike `bench-matrix` this does NOT stop at the first broken cell: a failing
# bring-up, seed or scenario is recorded and the sweep carries on, so one pass
# gives you the full list of what to fix. Exits non-zero if anything failed.
#
# `repeat` is deliberately ignored (a rehearsal has nothing to median), and
# results go to results/dry-run/ so `bench-report`/`bench-pack` never see them.
#
#   just targets="axiam keycloak zitadel" profiles="p0-plaintext p2-tls13 p3-mtls" bench-dry-run
#
# Knobs (env, not `just` vars): BENCH_DRY_VUS (2), BENCH_DRY_DURATION (5s),
# BENCH_DRY_WARMUP (2s), BENCH_DRY_COOLDOWN (1s), BENCH_DRY_MAX_P95_MS (30000).
bench-dry-run:
    #!/usr/bin/env bash
    # NOT `set -e`: a broken cell is the OUTPUT of a dry run, not a reason to
    # abandon the remaining ones.
    set -uo pipefail
    BASE_RESULTS_DIR="${BENCH_RESULTS_DIR:-$PWD/results/dry-run}"
    mkdir -p "$BASE_RESULTS_DIR"
    export BENCH_RESULTS_DIR="$BASE_RESULTS_DIR"
    # One ledger for the whole sweep: run-benchmark.sh appends its per-scenario
    # verdicts here, and the bring-up/seed failures below go in the same file so
    # the closing table covers every stage, not just the k6 cells.
    export BENCH_DRY_RUN_TSV="$BASE_RESULTS_DIR/dry-run.tsv"
    : > "$BENCH_DRY_RUN_TSV"
    started=$(date +%s)
    note() { printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5" >> "$BENCH_DRY_RUN_TSV"; }
    # Teardown is graded on EVERY path, including the failure paths. The old
    # `bench-down >/dev/null 2>&1 || true` after a failed bring-up/seed hid the
    # one error that poisons the rest of the sweep: a stack that would not go
    # down keeps its published ports, and every later target then dies in its
    # port pre-flight with a message pointing at the port rather than at the
    # cell that leaked it.
    teardown() {  # TARGET PROFILE
      just target=$1 bench-down >/dev/null 2>&1 || \
        note "$1" "$2" "(bench-down)" WARN "teardown failed — the stack is STILL RUNNING and its ports will fail the next cell's pre-flight; run 'just target=$1 bench-down' by hand"
    }

    for t in {{targets}}; do
      for p in {{profiles}}; do
        echo "=== dry-run: $t / $p (rl={{rl}} dbcaps={{dbcaps}}) ==="
        if ! just target=$t profile=$p rl={{rl}} dbcaps={{dbcaps}} build={{build}} bench-up; then
          note "$t" "$p" "(bench-up)" FAIL "stack never came up / never became ready — see the compose ps+logs dumped above"
          teardown "$t" "$p"
          continue
        fi
        if ! just target=$t profile=$p bench-seed; then
          note "$t" "$p" "(bench-seed)" FAIL "seeding or its post-seed smoke checks failed — this is the failure that would abort the real matrix"
          teardown "$t" "$p"
          continue
        fi
        just target=$t profile=$p dry=1 bench-run || true
        teardown "$t" "$p"
      done
    done

    elapsed=$(( $(date +%s) - started ))
    {
      echo "# Benchmark dry run"
      echo
      echo "Rehearsed \`targets={{targets}}\` x \`profiles={{profiles}}\` in $((elapsed / 60))m $((elapsed % 60))s."
      echo "Verdicts grade the k6 client contract (connect / request / expected response), not performance."
      echo
      echo "| Verdict | Target | Profile | Scenario | Detail |"
      echo "|---|---|---|---|---|"
      awk -F'\t' '{ printf "| %s | %s | %s | `%s` | %s |\n", $4, $1, $2, $3, $5 }' "$BENCH_DRY_RUN_TSV"
    } > "$BASE_RESULTS_DIR/SUMMARY.md"

    echo
    echo "──────────── DRY RUN SUMMARY ────────────"
    awk -F'\t' '{ printf "  %-5s %-9s %-13s %-26s %s\n", $4, $1, $2, $3, $5 }' "$BENCH_DRY_RUN_TSV"
    echo
    awk -F'\t' '
      { n[$4]++ }
      END { printf "  %d PASS, %d WARN, %d SKIP, %d FAIL\n", n["PASS"], n["WARN"], n["SKIP"], n["FAIL"] }
    ' "$BENCH_DRY_RUN_TSV"
    echo "  elapsed: $((elapsed / 60))m $((elapsed % 60))s — wrote $BASE_RESULTS_DIR/SUMMARY.md"
    # Flag-then-END, not `{exit 0}`: an awk `exit` inside a rule still runs the
    # END block, so `$4=="FAIL"{exit 0} END{exit 1}' would always report clean.
    if awk -F'\t' '$4=="FAIL"{f=1} END{exit !f}' "$BENCH_DRY_RUN_TSV"; then
      echo
      echo "  Do NOT start the real matrix yet — the cells above marked FAIL would break it."
      echo "  Per-cell k6 output: $BASE_RESULTS_DIR/<target>/<profile>/<scenario>.dryrun.log"
      exit 1
    fi
    echo
    echo "  All cells satisfied the client contract. Safe to run: just targets=\"{{targets}}\" profiles=\"{{profiles}}\" bench-matrix"

# --- SDK client benchmarks --- (pass the language as sdk=, e.g. sdk=python)
# H8 fix: `bash sdk/<lang>/run.sh` alone never saw the seed env (only
# sdk-bench-all did, via run-all.sh's own sourcing) — a bench invoked this way
# got BENCH_RESOURCE_ID="" and either crashed (rust: "must be a valid UUID
# (got \"\")") or silently hit a non-existent "bench-resource" id. Source the
# same .seed/<target>.seed.env the k6 harness uses, and fail fast (naming the
# exact missing var) rather than let a language-specific bench discover it
# later with a confusing error.
#
# Profile wiring (fix): neither recipe used to source profiles/<profile>.env,
# so every SDK bench saw the cross-profile defaults from its own `env()`
# fallbacks — http://localhost:8090, no CA — no matter what `profile=` said.
# `just profile=p2-tls13 sdk-bench-all` therefore measured PLAINTEXT and, since
# run-all.sh keys its output dir on BENCH_PROFILE (unset → "p0-plaintext"),
# filed the records under results/sdk/p0-plaintext/. The label and the wire
# were consistently wrong together, which is why it looked like only a pathing
# bug. Sourcing the profile env fixes both at once: BENCH_SCHEME/HOST/PORT
# point the benches at the right listener and BENCH_PROFILE labels + scopes the
# output. BENCH_CERTS_DIR is absolutized first (same reason as
# run-benchmark.sh: the profile derives BENCH_CA_CERT/CLIENT_CERT from it, and
# some benches chdir before opening them).
sdk-bench:
    #!/usr/bin/env bash
    set -euo pipefail
    export BENCH_CERTS_DIR="${BENCH_CERTS_DIR:-$PWD/profiles/certs}"
    # shellcheck disable=SC1090
    source profiles/{{profile}}.env
    export BENCH_PROFILE="{{profile}}"
    SEED_DIR="${BENCH_SEED_DIR:-.seed}"
    SEED_ENV="$SEED_DIR/{{target}}.seed.env"
    if [ -f "$SEED_ENV" ]; then
      # shellcheck disable=SC1090
      source "$SEED_ENV"
    else
      echo "[sdk-bench] WARN: no seed env at $SEED_ENV — run 'just target={{target}} bench-seed' first" >&2
    fi
    for var in BENCH_RESOURCE_ID BENCH_SUBJECT_ID BENCH_TENANT_SLUG BENCH_CLIENT_ID BENCH_CLIENT_SECRET; do
      if [ -z "${!var:-}" ]; then
        echo "[sdk-bench] FATAL: $var is empty after sourcing $SEED_ENV — re-run 'just target={{target}} bench-seed' (H8: seed env must reach the SDK bench)." >&2
        exit 1
      fi
    done
    export BENCH_TARGET="{{target}}"
    # shellcheck disable=SC1091
    source sdk/_preflight.sh; preflight_target || exit 1
    echo "[sdk-bench] {{sdk}} @ {{profile}} -> ${BENCH_SCHEME}://${BENCH_HOST:-localhost}:${BENCH_PORT} (records under results/sdk/{{profile}}/)"
    bash sdk/{{sdk}}/run.sh

sdk-bench-all:
    #!/usr/bin/env bash
    set -euo pipefail
    export BENCH_CERTS_DIR="${BENCH_CERTS_DIR:-$PWD/profiles/certs}"
    # shellcheck disable=SC1090
    source profiles/{{profile}}.env
    export BENCH_PROFILE="{{profile}}"
    export BENCH_TARGET="{{target}}"
    RESULTS_ROOT="${BENCH_RESULTS_DIR:-$PWD/results}"
    # p3-mtls presents a client certificate on every request (CONTRACT.md
    # §6.1). Every language bench is wired for it; `just sdk-bench-test`
    # verifies that without a live stack.
    if [ "{{profile}}" = "p3-mtls" ]; then
      echo "[sdk-bench-all] p3-mtls: every bench presents profiles/certs/client.crt (CONTRACT.md §6.1). Verify the wiring without a live stack: just sdk-bench-test" >&2
    fi
    # One connect attempt before eleven benches spend ~20 minutes producing
    # eleven differently-worded copies of the same "server unreachable".
    # shellcheck disable=SC1091
    source sdk/_preflight.sh; preflight_target || exit 1

    # I15 (improvement-after-run4-benchmark.md §D): wire the k6 baseline back
    # in — collect.py's "p95 overhead vs wire" column (OP_TO_SCENARIO) reads
    # results/<target>/<profile>/<scenario>.meta.json for exactly these three
    # scenarios, and was empty in run 4 because no matched-concurrency k6 pass
    # had been captured. BENCH_VUS is set equal to SDK_BENCH_CONCURRENCY (the
    # draft-4 lesson: an unmatched-VU baseline, e.g. the default 50-VU ramp,
    # produces bogus — often negative — "overhead" purely from the load-shape
    # mismatch, not genuine SDK cost). Skippable with SDK_BENCH_SKIP_WIRE=1
    # (e.g. a quick re-run when a fresh baseline already exists on disk).
    SDK_BENCH_CONCURRENCY="${SDK_BENCH_CONCURRENCY:-16}"
    if [ "${SDK_BENCH_SKIP_WIRE:-0}" != "1" ]; then
      echo "[sdk-bench-all] wire baseline: oauth2_password_login/authz_check_rest/authz_batch_rest @ BENCH_VUS=$SDK_BENCH_CONCURRENCY (matches SDK_BENCH_CONCURRENCY)" >&2
      for s in oauth2_password_login.js authz_check_rest.js authz_batch_rest.js; do
        BENCH_VUS="$SDK_BENCH_CONCURRENCY" BENCH_RESULTS_DIR="$RESULTS_ROOT" \
          bash runner/run-benchmark.sh --target {{target}} --profile {{profile}} --scenario "$s"
      done
    else
      echo "[sdk-bench-all] SDK_BENCH_SKIP_WIRE=1 — skipping the k6 wire-baseline pass" >&2
    fi

    # I15: repeat=N (default 3, same knob/default as the server-side matrix's
    # C1 median-of-N) runs the SDK pass N times and medians per-op numbers
    # across the "ok" passes (sdk/median.py) — one bad pass (e.g. transient
    # network blip) no longer produces the SDK section's number of record.
    # repeat=1 keeps the old single-pass behavior, writing straight into
    # $RESULTS_ROOT/sdk/{{profile}}/ with no merge step.
    REPEAT="{{repeat}}"
    if [ "$REPEAT" -le 1 ] 2>/dev/null; then
      echo "[sdk-bench-all] {{target}} @ {{profile}} -> ${BENCH_SCHEME}://${BENCH_HOST:-localhost}:${BENCH_PORT} (records under $RESULTS_ROOT/sdk/{{profile}}/)"
      BENCH_RESULTS_DIR="$RESULTS_ROOT" bash sdk/run-all.sh
    else
      echo "[sdk-bench-all] {{target}} @ {{profile}} -> ${BENCH_SCHEME}://${BENCH_HOST:-localhost}:${BENCH_PORT} (median of $REPEAT passes -> $RESULTS_ROOT/sdk/{{profile}}/)"
      PASS_DIRS=()
      for i in $(seq 1 "$REPEAT"); do
        PASS_DIR="$RESULTS_ROOT/sdk-run-$i"
        echo "[sdk-bench-all] pass $i/$REPEAT -> $PASS_DIR" >&2
        BENCH_RESULTS_DIR="$PASS_DIR" bash sdk/run-all.sh
        PASS_DIRS+=("$PASS_DIR")
      done
      # J8: median.py exits non-zero when any language merged fewer than
      # $REPEAT passes — run 5 shipped a C# "median of 2" against repeat=3 and
      # nobody noticed until analysis. The merged records and the report are
      # still written (the exit code is the LAST thing it does), so collect.py
      # below still runs and the operator still gets the numbers; what changes
      # is that the shell's exit status, and the SDK_BENCH_MEDIAN_INCOMPLETE
      # banner, make the gap impossible to scroll past. Set
      # SDK_BENCH_ALLOW_PARTIAL=1 to accept it deliberately.
      MEDIAN_RC=0
      if [ "${SDK_BENCH_ALLOW_PARTIAL:-0}" = "1" ]; then
        python3 sdk/median.py --runs "${PASS_DIRS[@]}" --out "$RESULTS_ROOT" --allow-partial
      else
        python3 sdk/median.py --runs "${PASS_DIRS[@]}" --out "$RESULTS_ROOT" || MEDIAN_RC=$?
      fi
    fi
    python3 sdk/collect.py --results "$RESULTS_ROOT"
    if [ "${MEDIAN_RC:-0}" != "0" ]; then
      echo "[sdk-bench-all] SDK_BENCH_MEDIAN_INCOMPLETE: at least one language merged fewer passes than repeat={{repeat}} — see the [median] lines above and each record's passes_missing. The report above is still valid data; it is just built on fewer passes than requested." >&2
      exit "$MEDIAN_RC"
    fi

# ---------------------------------------------------------------------------
# bench-nested (N1) — nested-resource authorization, swept by depth
# ---------------------------------------------------------------------------
#
# The question this answers: what does it cost to authorize a resource that
# sits N levels below the one carrying the grant, and how does that cost move
# as N grows — for AXIAM, Keycloak and Zitadel, over REST and (where the
# capability exists at all) gRPC.
#
#   just bench-nested                                    # the default ladder, p0
#   just profile=p2-tls13 bench-nested                   # same ladder over TLS 1.3
#   just nestedtargets="axiam" nesteddepths="0 4 16" bench-nested
#   just bench-nested-report                             # re-render the summary only
#
# Each rung is a real measured cell run through the SAME runner as every matrix
# cell (settle gate, samplers, meta.json), written into its own subtree:
#
#     results/nested/d<N>/<target>/<profile>/authz_nested_{rest,grpc}.*
#
# That is one level deeper than `report.py`'s walk reaches, so `bench-report`
# never sees these cells — deliberately, exactly as it never sees
# results/dry-run/. A depth ladder is not a matrix: its cells differ in a knob,
# not in a target/profile coordinate, and medianing or ranking them alongside
# matrix cells would be meaningless. `runner/nested_report.py` is this tree's
# own reader and it runs automatically at the end of the sweep.
#
# WHAT THE THREE ARMS MEASURE — this is not a like-for-like race, and the
# summary says so on every table. Only AXIAM has a hierarchical resource model;
# Keycloak expresses nesting as URI paths over a flat resource set; Zitadel has
# no per-resource decision endpoint at all and its arm is a declared capability
# gap. See `scenarios/lib/nested.js`'s header for the full reasoning, and
# `claude_dev/quick-bench-runbook-2026-08-16.md` §9 for the run procedure.
#
# ONE STACK PER TARGET, SWEPT: the ladder brings each target up once, seeds it
# once, and runs every depth against that one stack — the chain is provisioned
# incrementally in setup() and re-used, so a deeper rung adds levels rather
# than rebuilding. That is minutes instead of hours, at the cost of later rungs
# meeting a warmer stack than earlier ones; `nestedpause` puts a settling gap
# between rungs and the per-cell settle gate still runs. If you need the
# cold-stack version, run the rungs by hand with a bench-down between them and
# say so in the write-up.
nesteddepths := "0 1 2 4 8 16"
nestedtargets := "axiam keycloak zitadel"
nestedvus := "50"
nestedwarmup := "20s"
nesteddur := "60s"
nestedpause := "30"

bench-nested:
    #!/usr/bin/env bash
    set -euo pipefail

    SWEEP="${BENCH_RESULTS_DIR:-$PWD/results}/nested"
    mkdir -p "$SWEEP"

    # Validate the ladder BEFORE spending any bring-up time. A non-numeric rung
    # would reach k6 as BENCH_AUTHZ_DEPTH=<garbage>, which lib/nested.js clamps
    # to 0 — i.e. it would silently measure the control point again and file it
    # under a directory named after the depth nobody actually ran. The ceiling
    # is MAX_NESTED_DEPTH in scenarios/lib/nested.js, itself well below
    # crates/axiam-db's MAX_ANCESTOR_DEPTH=50, past which get_ancestors returns
    # an ERROR rather than a walk.
    for d in {{nesteddepths}}; do
      case "$d" in ''|*[!0-9]*)
        echo "[bench-nested] depth '$d' is not a non-negative integer (nesteddepths=\"{{nesteddepths}}\")" >&2
        exit 1 ;;
      esac
      if [ "$d" -gt 40 ]; then
        echo "[bench-nested] depth $d exceeds MAX_NESTED_DEPTH=40 (scenarios/lib/nested.js). AXIAM's" >&2
        echo "               get_ancestors ERRORS at 50 ancestors, so a rung near it would measure the" >&2
        echo "               depth-overflow path, not the authorization path." >&2
        exit 1
      fi
    done

    echo "[bench-nested] targets=\"{{nestedtargets}}\" depths=\"{{nesteddepths}}\" profile={{profile}}"
    echo "[bench-nested] load: {{nestedvus}} VUs, warm-up {{nestedwarmup}}, measured {{nesteddur}} per rung"
    echo

    for t in {{nestedtargets}}; do
      echo "=== nested sweep: $t / {{profile}} (rl={{rl}} dbcaps={{dbcaps}}) ==="
      just target=$t profile={{profile}} rl={{rl}} dbcaps={{dbcaps}} build={{build}} bench-up
      # Seed ONCE per target, into the sweep root. seed.sh honours
      # BENCH_RESULTS_DIR for its post-smoke-check marker, and run-benchmark.sh
      # refuses to start without that marker in ITS results dir — which is a
      # different (per-depth) directory here. Copying the marker per rung keeps
      # the guard intact without re-seeding (and therefore re-timing) every rung.
      BENCH_RESULTS_DIR="$SWEEP" just target=$t profile={{profile}} bench-seed

      for d in {{nesteddepths}}; do
        RUN_DIR="$SWEEP/d$d"
        mkdir -p "$RUN_DIR"
        cp "$SWEEP/$t.seed.ok" "$RUN_DIR/$t.seed.ok"
        for s in authz_nested_rest.js authz_nested_grpc.js; do
          # The gRPC arm is AXIAM-only (no competitor in this target set exposes
          # a gRPC authorization-decision RPC). run-benchmark.sh's
          # AXIAM_ONLY_SCENARIOS filter would skip it anyway; skipping here too
          # avoids spending a settle gate on a cell that cannot run.
          if [ "$s" = "authz_nested_grpc.js" ] && [ "$t" != "axiam" ]; then continue; fi
          echo "--- $t depth=$d $s ---"
          BENCH_RESULTS_DIR="$RUN_DIR" \
          BENCH_AUTHZ_DEPTH="$d" \
          BENCH_VUS="{{nestedvus}}" BENCH_WARMUP="{{nestedwarmup}}" BENCH_DURATION="{{nesteddur}}" \
            just target=$t profile={{profile}} scenario=$s bench-run
          if [ "{{nestedpause}}" -gt 0 ] 2>/dev/null; then
            echo "[bench-nested] pausing {{nestedpause}}s before the next rung (nestedpause=0 to disable)"
            sleep {{nestedpause}}
          fi
        done
      done

      just target=$t bench-down
    done

    echo
    # nested_report.py exits 1 when any rung is invalid. That is information,
    # not a reason to lose the summary it has already written — so capture it,
    # print the sweep's own closing banner, and only then propagate.
    rc=0
    python3 runner/nested_report.py --results "$SWEEP" || rc=$?
    echo "[bench-nested] sweep complete — $SWEEP/SUMMARY.md"
    if [ "$rc" -ne 0 ]; then
      echo "[bench-nested] at least one rung is INVALID (see the summary's 'Invalid rungs' table)." >&2
      echo "               Do not publish the ladder until those rungs are re-run or explained." >&2
    fi
    exit "$rc"

# Re-render results/nested/SUMMARY.md from an existing sweep tree — no
# containers, no k6. Use after hand-running extra rungs, or to re-read a packed
# archive. Honours BENCH_RESULTS_DIR the same way `bench-nested` does.
bench-nested-report:
    python3 runner/nested_report.py --results "${BENCH_RESULTS_DIR:-$PWD/results}/nested"

# Hermetic regression guard for the nested sweep's harness wiring: asserts the
# depth knob reaches meta.json, that the sweep cells stay OUT of the default
# `--scenario all` set, and that nested_report.py reads a sweep tree and
# refuses to fabricate a depth slope for the capability-gap arm. No docker, no
# k6, no seeded stack — CI runs the same script on every PR.
bench-nested-selftest:
    bash runner/nested-selftest.sh

# Verify every language bench presents its p3-mtls client certificate
# (CONTRACT.md §6.1) — no AXIAM stack, no seed, no containers required: the
# test stands up a stub HTTPS server that DEMANDS a client cert and asserts
# each bench was seen presenting CN=bench-client on the wire. Run it after
# touching any bench's TLS wiring, and before trusting a p3 SDK pass.
#
#   just sdk-bench-test                 # every wired language
#   just sdk-bench-test python          # one language (args pass through)
#   STRICT=1 just sdk-bench-test        # known upstream blockers fail too
sdk-bench-test *languages:
    bash runner/gen-certs.sh
    bash sdk/test-client-cert-wiring.sh {{languages}}

# Remove all run artifacts (keeps the dir).
bench-clean:
    find results -type f ! -name '.gitkeep' -delete || true

# Package shareable results into results-<date>.tar.xz. k6 summaries,
# resource/host CSVs, run metadata, the generated report AND every
# investigation artifact (*.md / *.log / *.tsv / *.txt) are included — NOT
# .seed/ (client secrets, bench user password), which report.py and this
# recipe never read from and which `git` never sees (see .gitignore / A7 in
# claude_dev/benchmark-improvement-plan.md). The selection lives in
# runner/pack-filelist.sh so `bench-pack-selftest` can exercise exactly this
# logic rather than a re-implementation of it (J13/E2). Verifies the archive
# is clean before leaving it on disk.
bench-pack:
    #!/usr/bin/env bash
    set -euo pipefail
    OUT="results-$(date +%Y-%m-%d).tar.xz"
    FILELIST="$(mktemp)"
    trap 'rm -f "$FILELIST"' EXIT
    bash runner/pack-filelist.sh results > "$FILELIST"
    if [ ! -s "$FILELIST" ]; then
      echo "[bench-pack] nothing to pack — run a benchmark + 'just bench-report' first" >&2
      exit 1
    fi
    tar -cJf "$OUT" -T "$FILELIST"
    echo "[bench-pack] wrote $OUT ($(wc -l < "$FILELIST") files)"
    echo "[bench-pack] verifying no secret material leaked in..."
    if tar -tJf "$OUT" | grep -qiE '\.seed/|seed\.env'; then
      echo "[bench-pack] ERROR: a .seed/ path made it into the archive" >&2; exit 1
    fi
    # G2 item 3: meta.json's "axiam_env" (the AXIAM__* pass-through knob dump,
    # run-benchmark.sh's axiam_env_json()) legitimately writes the NAME of
    # every redacted key — e.g. "AXIAM__DB__PASSWORD": "<redacted>" — so the
    # setting's presence stays visible even though its value never is. Those
    # key names themselves contain PASSWORD/SECRET-shaped substrings, so
    # strip out every already-redacted line (identified by the literal
    # "<redacted>" placeholder value axiam_env_json() always writes) BEFORE
    # scanning for leaked content — an actual leaked value would never carry
    # that placeholder, so this can't hide a real leak, only the expected,
    # fully-redacted key names.
    if tar -xJOf "$OUT" | grep -vi '<redacted>' | grep -qiE 'SECRET|PASSWORD'; then
      echo "[bench-pack] ERROR: SECRET/PASSWORD text found in packed content — investigate before sharing" >&2
      exit 1
    fi
    echo "[bench-pack] OK — $OUT contains no secret material."

# J13/E2 regression guard for the bench-pack manifest: builds a fixture
# results tree carrying one of every artifact shape run 5 produced, runs the
# REAL selection logic over it, and asserts both directions. Hermetic (no
# docker, no k6) — CI runs the same script on every PR.
bench-pack-selftest:
    bash runner/pack-selftest.sh

# ---------------------------------------------------------------------------
# bench-quick (X5) — the two cells the archive is missing, in minutes
# ---------------------------------------------------------------------------
#
# `bench-matrix` is hours. This is not that, and must never be read as that.
#
# It measures ONE thing properly: the per-request cost of RFC 8705
# certificate-bound access tokens, as an A/B between two AXIAM clients that
# differ in exactly one registered field. Single target (axiam), single profile
# (p3-mtls, because binding requires a client certificate), one short window per
# arm, no repeats, no cross-product.
#
#   just bench-quick
#
# Knobs: quickdur (measured window per arm, default 45s), quickvus (default 20).
# Everything else is fixed on purpose — the value of this recipe is that two
# people running it are running the same thing.
#
# WHAT A RUN OF THIS SIZE ESTABLISHES, AND WHAT IT DOES NOT: printed by the
# recipe itself, at the end, every time. Read it. A single unrepeated 45-second
# window on shared hardware is an indicative number, not a matrix result, and
# this project publishes its receipts precisely so that the difference stays
# visible.
quickdur := "45s"
quickvus := "20"

bench-quick:
    #!/usr/bin/env bash
    set -euo pipefail

    OUT="${BENCH_RESULTS_DIR:-$PWD/results}/quick"
    mkdir -p "$OUT"
    TARGET=axiam
    PROFILE=p3-mtls

    command -v k6 >/dev/null || { echo "[bench-quick] k6 is not installed" >&2; exit 1; }
    command -v jq >/dev/null || { echo "[bench-quick] jq is required" >&2; exit 1; }

    echo "[bench-quick] target=$TARGET profile=$PROFILE vus={{quickvus}} window={{quickdur}} per arm"
    echo "[bench-quick] two arms, no repeats. Expect ~4 minutes including bring-up."
    echo

    # ---------------------------------------------------------------------
    # Cell 1 — mTLS certificate-binding overhead
    # ---------------------------------------------------------------------
    #
    # The A/B is two clients on the SAME running server, over the SAME mTLS
    # connections, on the SAME scenario, differing in exactly one registered
    # field: tls_client_certificate_bound_access_tokens.
    #
    # Both authenticate with client_secret_post rather than mTLS. That is
    # deliberate and it is what makes this measurement mean "binding" rather
    # than "mTLS": the client certificate is present on the connection for
    # both arms (p3 requires it), so the handshake cost, the TLS record cost
    # and the certificate's presence are all held constant. The only thing
    # that varies is whether AXIAM stamps a cnf.x5t#S256 claim into the token
    # it mints. Measuring an mTLS-authenticating client against a
    # secret-authenticating one would have conflated two changes and produced
    # a number nobody could attribute.

    source profiles/$PROFILE.env
    BASE="https://${BENCH_HOST:-localhost}:${BENCH_PORT:-8443}"
    SEED_ENV="${BENCH_SEED_DIR:-$PWD/.seed}/$TARGET.seed.env"
    [ -f "$SEED_ENV" ] || { echo "[bench-quick] no seed at $SEED_ENV — run 'just target=axiam profile=p3-mtls bench-up && just target=axiam bench-seed' first" >&2; exit 1; }
    source "$SEED_ENV"

    # Admin calls reuse seed.sh's mechanism exactly — cookie session plus CSRF
    # double-submit — rather than inventing a bearer-token path that the seeded
    # fixture has no way to produce. The admin credential is the same one
    # `bench-seed` bootstrapped, so a machine that can seed can run this.
    JAR="$(mktemp)"; trap 'rm -f "$JAR"' EXIT
    ADMIN_PW="${BENCH_ADMIN_PASSWORD:-Bench@Admin123!}"
    curl -sSk --cert "$BENCH_CLIENT_CERT" --key "$BENCH_CLIENT_KEY" \
      -c "$JAR" -X POST "$BASE/api/v1/auth/login" -H "Content-Type: application/json" \
      -d "{\"org_slug\":\"${BENCH_ORG_SLUG:-bench-org}\",\"tenant_slug\":\"${BENCH_TENANT_SLUG:-default}\",\"username_or_email\":\"admin\",\"password\":\"$ADMIN_PW\"}" \
      >/dev/null
    awk -F'\t' '$6=="axiam_access"{f=1} END{exit !f}' "$JAR" \
      || { echo "[bench-quick] admin login failed — is the stack seeded?" >&2; exit 1; }

    make_client() {
      # $1: name, $2: bound (true|false)
      local csrf body
      csrf="$(awk -F'\t' '$6=="axiam_csrf"{v=$7} END{print v}' "$JAR")"
      body="$(jq -n --arg n "$1" --argjson b "$2" '{
        name: $n,
        redirect_uris: ["http://localhost/cb"],
        grant_types: ["client_credentials"],
        scopes: ["openid"],
        tls_client_certificate_bound_access_tokens: $b
      }')"
      curl -sSk --cert "$BENCH_CLIENT_CERT" --key "$BENCH_CLIENT_KEY" \
        -b "$JAR" -c "$JAR" -X POST "$BASE/api/v1/oauth2-clients" \
        -H "Content-Type: application/json" -H "X-CSRF-Token: $csrf" -d "$body"
    }

    echo "[bench-quick] registering the A/B pair"
    UNBOUND=$(make_client "quick-unbound" false)
    BOUND=$(make_client "quick-bound" true)
    for pair in "UNBOUND:$UNBOUND" "BOUND:$BOUND"; do
      label="${pair%%:*}"
      if [ -z "$(jq -r '.client_id // empty' <<<"${pair#*:}")" ]; then
        echo "[bench-quick] could not register the $label client: ${pair#*:}" >&2; exit 1
      fi
    done

    run_arm() {
      # $1: arm label, $2: client json
      local arm="$1" client="$2"
      echo "[bench-quick] arm: $arm"
      BENCH_CLIENT_ID=$(jq -r .client_id <<<"$client") \
      BENCH_CLIENT_SECRET=$(jq -r .client_secret <<<"$client") \
      BENCH_VUS={{quickvus}} BENCH_WARMUP=10s BENCH_DURATION={{quickdur}} BENCH_COOLDOWN=5s \
      k6 run --quiet --summary-export "$OUT/binding-$arm.k6.json" \
        scenarios/oauth2_client_credentials.js >"$OUT/binding-$arm.log" 2>&1 \
        || { echo "[bench-quick] the $arm arm failed; see $OUT/binding-$arm.log" >&2; exit 1; }
    }

    run_arm unbound "$UNBOUND"
    run_arm bound "$BOUND"

    # ---------------------------------------------------------------------
    # Cell 2 — X1 reactor hook cost (conditional, by design)
    # ---------------------------------------------------------------------
    #
    # X5's bench list asks for this "if and only if X1 is on main". It is not
    # enough for X1's CODE to be on main: measuring a hook costs nothing to
    # measure if the hook is never called. So the condition checked here is
    # whether a reactor dispatcher is actually invoked from a request path,
    # not whether the module exists.
    #
    # As of this recipe's addition it is not: crates/axiam-amqp carries the
    # dispatcher, the event model, the DB config and the admin CRUD, but
    # nothing outside that module invokes ReactorDispatcher — X1.4
    # (server-side dispatch) is not wired. So this cell reports that it did
    # not run, and why, rather than producing the cost of a code path that
    # never executes.
    HOOK_STATE="not wired"
    if grep -rqs "ReactorDispatcher" ../crates/axiam-api-rest/src ../crates/axiam-oauth2/src 2>/dev/null; then
      HOOK_STATE="wired"
    fi

    # ---------------------------------------------------------------------
    # Report
    # ---------------------------------------------------------------------
    python3 - "$OUT" "$HOOK_STATE" "{{quickdur}}" "{{quickvus}}" <<'PY'
    import json, pathlib, sys

    out, hook_state, window, vus = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]

    def arm(name):
        d = json.loads((out / f"binding-{name}.k6.json").read_text())
        m = d.get("metrics", {})
        lat = m.get("bench_op_latency_ms", {})
        return {
            "rps": m.get("iterations", {}).get("rate", 0.0),
            "p50": lat.get("med", 0.0),
            "p95": lat.get("p(95)", 0.0),
            "p99": lat.get("p(99)", 0.0),
        }

    a, b = arm("unbound"), arm("bound")

    def delta(x, y):
        return ((y - x) / x * 100.0) if x else float("nan")

    lines = []
    lines.append("# bench-quick — indicative, NOT a matrix result")
    lines.append("")
    lines.append(f"One unrepeated {window} window per arm at {vus} VUs, single target (axiam),")
    lines.append("single profile (p3-mtls), no cross-product.")
    lines.append("")
    lines.append("## Cell 1 — RFC 8705 certificate-binding overhead")
    lines.append("")
    lines.append("Two clients on one server, same connections, same scenario, differing in")
    lines.append("exactly one registered field (`tls_client_certificate_bound_access_tokens`).")
    lines.append("")
    lines.append("| Metric | unbound | certificate-bound | delta |")
    lines.append("|---|---:|---:|---:|")
    lines.append(f"| throughput (req/s) | {a['rps']:.1f} | {b['rps']:.1f} | {delta(a['rps'], b['rps']):+.1f}% |")
    lines.append(f"| p50 latency (ms) | {a['p50']:.2f} | {b['p50']:.2f} | {delta(a['p50'], b['p50']):+.1f}% |")
    lines.append(f"| p95 latency (ms) | {a['p95']:.2f} | {b['p95']:.2f} | {delta(a['p95'], b['p95']):+.1f}% |")
    lines.append(f"| p99 latency (ms) | {a['p99']:.2f} | {b['p99']:.2f} | {delta(a['p99'], b['p99']):+.1f}% |")
    lines.append("")
    lines.append("## Cell 2 — X1 reactor hook cost")
    lines.append("")
    if hook_state == "wired":
        lines.append("A reactor dispatcher IS invoked from a request path, so this cell is now")
        lines.append("measurable and this recipe needs the arm written. It has not been.")
    else:
        lines.append("**Not run.** X1's dispatcher, event model, DB config and admin CRUD are on")
        lines.append("main, but nothing outside `crates/axiam-amqp/src/reactor/` invokes")
        lines.append("`ReactorDispatcher` — X1.4 (server-side dispatch) is not wired into any")
        lines.append("request path. There is no hook on the token path to measure, and")
        lines.append("measuring one anyway would report the cost of code that never executes.")
    lines.append("")
    lines.append("## What this run establishes")
    lines.append("")
    lines.append("- The **direction and rough size** of the binding overhead on this machine,")
    lines.append("  for this scenario, under this profile.")
    lines.append("- That the bound arm works at all end to end — a smoke check the unit tests")
    lines.append("  cannot give you, because they never open a TLS connection.")
    lines.append("")
    lines.append("## What this run does NOT establish")
    lines.append("")
    lines.append("- **Anything with error bars.** One window per arm, no repeats. A delta")
    lines.append("  inside single-digit percent is not distinguishable from run-to-run noise")
    lines.append("  at this sample size; `bench-matrix`'s median-of-3 exists for exactly this")
    lines.append("  reason (methodology §8).")
    lines.append("- **A comparison against any other product.** No competitor ran.")
    lines.append("- **Behaviour under any other profile, scenario, or fixture size.** One cell")
    lines.append("  of a matrix is not the matrix.")
    lines.append("- **A publishable headline number.** If a claim in the plan or the README")
    lines.append("  rests on this figure, the claim must say it rests on an indicative")
    lines.append("  single-window measurement, or `bench-matrix` must be run.")
    lines.append("")
    lines.append("Artifacts: `results/quick/binding-*.k6.json`, `results/quick/binding-*.log`.")
    lines.append("These are NOT collected by `bench-report` or `bench-pack` — they are not")
    lines.append("matrix cells and must not be aggregated as though they were.")

    text = "\n".join(lines) + "\n"
    (out / "SUMMARY.md").write_text(text)
    print()
    print(text)
    PY

    echo "[bench-quick] wrote $OUT/SUMMARY.md"
