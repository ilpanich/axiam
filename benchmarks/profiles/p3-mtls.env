# Security profile p3: mutual TLS + X.509 client-cert auth on TLS 1.3.
# Strictest posture; exercises certificate-based authentication (IoT/mTLS).
export BENCH_PROFILE=p3-mtls
export BENCH_SCHEME=https
export BENCH_TLS_MIN=1.3
export BENCH_TLS_CIPHERS="TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256"
# k6 presents this client certificate; the server requires + verifies it.
export BENCH_CLIENT_CERT=${BENCH_CERTS_DIR:-profiles/certs}/client.crt
export BENCH_CLIENT_KEY=${BENCH_CERTS_DIR:-profiles/certs}/client.key
export BENCH_CA_CERT=${BENCH_CERTS_DIR:-profiles/certs}/ca.crt
# Throwaway private-CA edge cert; k6 cannot trust a custom CA (see p1-tls12.env).
# Skip SERVER-cert verification only — this is orthogonal to mTLS: k6 still
# presents its client cert via tlsAuth (BENCH_CLIENT_CERT/KEY) and the server
# still requires + verifies it. We measure TLS/mTLS termination cost, not trust.
export BENCH_VERIFY_TLS=false
export BENCH_PORT=${BENCH_TLS_PORT:-8443}
# Signals the target compose to require client certs (mTLS).
export BENCH_REQUIRE_CLIENT_CERT=true
# D2/D3: p3 composes targets/axiam/docker-compose.native-tls.yml (for the TLS 1.3
# listener) UNDER docker-compose.native-mtls.yml, so it inherits that overlay's
# AXIAM__GRPC_TLS_CERT_PATH/KEY_PATH — the tonic gRPC listener on :50051 speaks
# TLS here exactly as it does under p2-tls13. Without this flag the k6 gRPC
# scenarios dial plaintext into a TLS listener: no error is raised, the two sides
# just deadlock (client sends the HTTP/2 preface in cleartext, server waits for a
# ClientHello) until the 60s connect timeout, so every iteration aborts before
# its first check — the summary shows huge `iterations` with `checks_total: 0`.
# Note this is server-TLS only, NOT mTLS: the mTLS overlay's client verifier is
# on the REST surface (AXIAM__SERVER__TLS__CLIENT_AUTH), while tonic's
# ServerTlsConfig here is built with `.identity()` alone and requests no client
# cert (crates/axiam-api-grpc/src/server.rs). Hence a plain TLS dial suffices.
# As in p2, this var is consumed by the k6 process (run-benchmark.sh sources this
# file into the shell that invokes k6), not by the axiam-server container.
export BENCH_GRPC_PLAINTEXT=false
