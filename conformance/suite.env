# OIDF conformance-suite pin (X5.2).
#
# EVERY value here is pinned deliberately. A conformance result is evidence
# submitted to the OpenID Foundation, and evidence produced by "whatever the
# suite was that afternoon" is not reproducible — the whole point of publishing
# the receipts is that somebody else can regenerate them.
#
# To move the pin: change SUITE_VERSION, run `just conformance-up` (it will pull
# the new image), re-run the plans, and commit the new reports under
# docs/conformance/ ALONGSIDE the old ones rather than over them. A version bump
# that changes a verdict is itself a finding worth keeping.

# ---------------------------------------------------------------------------
# The suite
# ---------------------------------------------------------------------------

# gitlab.com/openid/conformance-suite release tag.
#
# W9 correction, found by the first run that ever tried to pull this: the
# previous value named `ghcr.io/openid/conformance-suite`, which does not exist
# — the pull fails with `denied`, which reads like a credentials problem and is
# not one. The suite is published to GitLab's registry, exactly as the line
# above always said. The comment was right and the value was wrong.
SUITE_VERSION=release-v5.2.4

# W9 correction, second half. The previous pin was `release-v5.1.34`, and that
# tag NO LONGER EXISTS: the project's registry retains only its most recent
# releases (nine, when this was written) and older tags are reaped. That is
# worth stating plainly, because this file spends a paragraph arguing that
# pinning is what makes a conformance result reproducible — and a *tag* pin is
# precisely the thing a retention policy can delete out from under you. It is
# reproducible only until upstream tidies up.
#
# So the digest below is the real pin, and the tag is a human-readable label
# for it. A digest is content-addressed: it cannot be moved, re-pointed or
# reaped while anybody still references it, and it is what §X5.3's submission
# means by "the digest that produced the green result".
#
# To move the pin: change BOTH lines together, re-run the plans, and commit the
# new reports alongside the old ones.
SUITE_DIGEST=sha256:3a2615ed95a7f3bb92d545b4c65c0268f82a3893d6cd97fd98fd8e44eb15d81f

# The image the compose file runs. Overridable so a deployment behind an egress
# policy can mirror it into a local registry without editing the compose file.
# Digest-addressed by default; set SUITE_IMAGE explicitly to run a tag instead,
# which is what you want while bisecting an upstream change and never what you
# want when producing evidence.
SUITE_IMAGE=registry.gitlab.com/openid/conformance-suite@${SUITE_DIGEST}

# The TLS front end (W9). The suite's own application serves plain HTTP on 8080
# and has no TLS of its own; upstream terminates TLS in an nginx sidecar built
# from the same repository, and every documented local-run compose file
# includes it. An earlier revision of conformance/docker-compose.yml trimmed
# that sidecar out as "an httpd fronting a hosted deployment" — it is not, it is
# where https://localhost.emobix.co.uk:8442 comes from, and without it the
# suite answers only http on a port nothing publishes.
#
# Its certificate is self-signed for CN=localhost, which is upstream's, so the
# harness's own conversation with the suite is `curl -k`. That is scoped to the
# suite; the suite's connections to AXIAM verify normally, which is the half
# that is under test.
SUITE_NGINX_DIGEST=sha256:43d34ca84e30669ebb30c5cdeb80b3f90bea0f5c47a446e915d843bd7dd3cf04
SUITE_NGINX_IMAGE=registry.gitlab.com/openid/conformance-suite/nginx@${SUITE_NGINX_DIGEST}

SUITE_PORT=8442
SUITE_BASE_URL=https://localhost.emobix.co.uk:${SUITE_PORT}

# ---------------------------------------------------------------------------
# The system under test
# ---------------------------------------------------------------------------

# The port AXIAM's TLS listener answers on.
#
# Split out of AXIAM_ISSUER in W9, because the first real run found 8443 already
# taken on the machine doing the running — it is a popular port, and the
# benchmark harness documents the same collision for BENCH_TLS_PORT. A
# conformance run must not require the operator to stop unrelated software, so
# the port is a variable and the issuer is derived from it. If you change this,
# you must ALSO set AXIAM__AUTH__OAUTH2_ISSUER_URL on the server to the same
# string: the issuer is an identity claim that appears in the discovery
# document and in every ID token, not merely a route, and the suite checks that
# the three agree.
AXIAM_TLS_PORT=8444

# AXIAM's issuer as the suite will see it. This MUST be reachable from inside
# the suite's container — `localhost` there is the suite, not AXIAM — which is
# why the default names the docker host gateway rather than loopback. The
# gateway is a real address (`host.docker.internal:host-gateway` in the compose
# file), so AXIAM must bind something other than loopback for it to be reachable
# at all.
AXIAM_ISSUER=https://host.docker.internal:${AXIAM_TLS_PORT}

# The same server, named from the OTHER side of the container boundary (W9).
#
# AXIAM_ISSUER is what the SUITE must use, and `host.docker.internal` resolves
# only inside a container (the compose file maps it to the docker bridge
# gateway). The harness's own scripts run on the HOST, where that name does not
# resolve at all — a registrar pointed at the issuer fails with
# "Could not resolve host: host.docker.internal" and looks like a networking
# fault rather than a category error.
#
# One server, two vantage points, so two URLs. The certificate gen-certs.sh
# mints carries both names in its SAN precisely so that neither side has to
# skip verification.
AXIAM_ADMIN_BASE_URL=https://localhost:${AXIAM_TLS_PORT}

# The tenant the conformance clients and the test user live in. Empty means the
# deployment-wide document; W7 made discovery tenant-aware and the `address` and
# `phone` scopes are only advertised when a tenant is named AND its organization
# has sensitive_scopes_enabled, so the Basic OP plan needs this set.
AXIAM_TENANT_ID=01a0813a-dda4-7e61-867c-4492d131b7c8

# The two clients the FAPI 2.0 OP test plan needs. Both must be registered with
# profile=fapi2; `conformance-register` provisions them and rewrites this file's
# CLIENT_* values in place.
#
# Variant 1 — mutual-TLS client authentication (RFC 8705 §2.1).
# AXIAM's own listener certificate and the CA that signed it (W9). The suite
# verifies the OP's TLS like any HTTPS client would, so the CA has to be
# trusted by the suite's JVM truststore — `conformance-up` injects it.
AXIAM_SERVER_CERT=certs/server.crt
AXIAM_SERVER_KEY=certs/server.key
AXIAM_CA=certs/ca.crt

CLIENT_MTLS_ID=
CLIENT_MTLS_CERT=certs/client-mtls.crt
CLIENT_MTLS_KEY=certs/client-mtls.key

# Variant 2 — self-signed mutual TLS (RFC 8705 §2.2). The second of the mTLS
# family's two methods; the certificate itself is the registered credential,
# matched by its `x5t#S256` thumbprint.
CLIENT_SELF_SIGNED_ID=
CLIENT_SELF_SIGNED_CERT=certs/client-self-signed.crt
CLIENT_SELF_SIGNED_KEY=certs/client-self-signed.key

# Variant 3 — `private_key_jwt` (RFC 7523 §2.2), the OTHER FAPI 2.0
# client-authentication family, plus DPoP sender-constraining.
#
# Earlier revisions of this file said `private_key_jwt` was not implemented and
# that running the mTLS variant twice was "NOT a full FAPI 2.0 submission".
# Both halves of that landed on 2026-08-14 and the note is retired: the three
# variants together cover both families across three methods.
#
# The JWKS values are the PUBLIC key sets the suite signs its client assertions
# with. `conformance-register` reads them out of the running suite and registers
# them as the AXIAM clients' INLINE `jwks` — deliberately not as a `jwks_uri`,
# because AXIAM fetches a registered jwks_uri through the SSRF-guarded cache,
# which refuses the private/loopback address a locally-run suite publishes on.
# See the runbook's failure table.
CLIENT_PRIVATE_KEY_JWT_ID=
CLIENT_PRIVATE_KEY_JWT_JWKS=
CLIENT_PRIVATE_KEY_JWT_2_ID=
CLIENT_PRIVATE_KEY_JWT_2_JWKS=

# The admin credential `conformance-register` uses to provision the clients.
#
# W9 correction. This file previously offered only AXIAM_ADMIN_TOKEN, a bearer
# — and nothing in AXIAM's documented admin flow produces one. An administrator
# authenticates at POST /api/v1/auth/login with an org slug and gets a SESSION:
# an HttpOnly cookie plus an X-CSRF-Token header that every mutating request
# must echo. `register-clients.sh` now performs that login itself and needs
# these three values; the bearer is kept as an override for a deployment that
# provisions with a service account's client_credentials token instead.
#
# Never commit a real password here. The script reads each from the environment
# when set, and falls back to these.
AXIAM_ADMIN_ORG_SLUG=test-org
AXIAM_ADMIN_USER=admin@axiam.dev
AXIAM_ADMIN_PASSWORD=
AXIAM_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# The Basic OP lane (W9)
# ---------------------------------------------------------------------------
#
# Two static clients for `oidcc-basic-certification-test-plan`, differing only
# in how they authenticate at the token endpoint. Both are `standard` profile
# (not fapi2: the Basic profile requires neither PAR nor sender-constrained
# tokens, and a fapi2 client would refuse the plan's plain authorization
# requests), and both carry browser_sso so the suite's redirect reaches a
# sign-in page instead of a 401 — see docs/admin/browser-login-hop.md.
CLIENT_BASIC_ID=
CLIENT_BASIC_SECRET=
CLIENT_BASIC_POST_ID=
CLIENT_BASIC_POST_SECRET=

# The end user the Basic plan authenticates as. Needs a phone number and an
# address, because the plan requests `address` and `phone` and several modules
# assert the claims come back — a user without them produces a REVIEW that
# looks like a server bug and is missing test data.
CONFORMANCE_USER=conformance-user@axiam.dev
CONFORMANCE_USER_PASSWORD=
