# AXIAM frontend nginx — rendered at container start by the stock nginx
# entrypoint (`/docker-entrypoint.d/20-envsubst-on-templates.sh`), which
# envsubsts `/etc/nginx/templates/*.template` into `/etc/nginx/conf.d/`.
#
# `NGINX_ENVSUBST_FILTER=^AXIAM_` is set in docker/Dockerfile.frontend so ONLY
# `AXIAM_`-prefixed names are substituted. Without it, envsubst would also
# replace nginx's own runtime variables — `$host`, `$remote_addr`,
# `$proxy_add_x_forwarded_for`, `$scheme`, `$uri` — with the empty string
# wherever a same-named environment variable happened to exist, which is a
# failure that shows up as mysteriously blank proxy headers rather than as an
# error.
#
# Two knobs, both with defaults that reproduce the previous plaintext behaviour
# exactly, so the dev stack and the E2E suite are unaffected:
#
#   AXIAM_BACKEND_ORIGIN  scheme://host:port of axiam-server.
#                         Default http://axiam-server:8090.
#                         Set https://... where the backend terminates its own
#                         TLS (claude_dev/public-backend-tls-design.md §5).
#   AXIAM_BACKEND_SNI     the name to send as SNI and to verify the backend
#                         certificate against. Only consulted for an https
#                         origin. Default `axiam-server`; on a deployment where
#                         the backend carries the public Let's Encrypt leaf,
#                         set it to the public hostname, because that is the
#                         name the certificate is actually issued for.
#   AXIAM_BACKEND_CA      PEM trust anchors for the backend certificate.
#                         Defaults to the system bundle, which is correct for a
#                         publicly-issued leaf. Point it at a private CA bundle
#                         if you issue the backend certificate yourself.
#
# There is deliberately no way to turn verification off. A backend certificate
# that does not verify is a misconfiguration to fix, not a check to disable, and
# an escape hatch here would be the first thing reached for at 3am.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 256;
    gzip_types
        text/html
        text/css
        application/javascript
        application/json
        image/svg+xml;

    # Security headers (OWASP-compliant)
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" always;
    # `'wasm-unsafe-eval'` below is what lets the admin UI run OPAQUE (RFC 9807).
    # The client is a WebAssembly build of crates/axiam-opaque, because CONTRACT
    # §23.1 forbids a client from reimplementing the protocol — and Chrome
    # refuses WebAssembly.instantiate outright when script-src is set without
    # it. The failure is silent from the page's point of view: the module load
    # throws, lib/opaque.ts degrades to `opaqueAvailable() === false`, and a
    # tenant on `opaque_mode: required` can then not sign in at all. It is far
    # narrower than 'unsafe-eval' — it permits compiling WebAssembly and nothing
    # else, no evaluation of JavaScript strings.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'" always;

    # Cache static assets for 1 year (Vite hashes filenames)
    location ~* \.(?:js|wasm|css|png|jpg|jpeg|gif|ico|svg|webp|avif|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";

        # Re-add security headers (add_header in a location block
        # replaces headers from the parent context)
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'" always;
    }

    # index.html must not be cached so deploys are picked up
    location = /index.html {
        add_header Cache-Control "no-cache";

        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'" always;
    }

    # SPA fallback — serve index.html for all unmatched routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to the backend (match both /api and /api/*)
    location /api {
        proxy_pass ${AXIAM_BACKEND_ORIGIN};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # A forwarded client certificate is only worth anything when the
        # forwarder verified it, and this one did not: nginx here terminates
        # server-auth TLS at most. Clearing it stops a client from asserting a
        # device identity by setting the header itself. The backend refuses it
        # anyway unless AXIAM__AUTH__TRUST_FORWARDED_CLIENT_CERT is on; this is
        # the other half of that defence, so neither has to be the only one.
        proxy_set_header X-Client-Certificate "";
        # Applied only when AXIAM_BACKEND_ORIGIN is https://; inert otherwise.
        proxy_ssl_server_name on;
        proxy_ssl_name ${AXIAM_BACKEND_SNI};
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate ${AXIAM_BACKEND_CA};
        proxy_ssl_protocols TLSv1.3;
    }

    # SEC-016: Proxy OAuth2 endpoints to the backend.
    #
    # The trailing slash is load-bearing. `location /oauth2` is a PREFIX match,
    # so it also captured `/oauth2-clients` — the admin UI's own SPA route —
    # and proxied it to a backend that has no such endpoint, returning a bare
    # 404 and a blank page for every principal, whatever their permissions.
    # Every backend OAuth2 endpoint lives under `/oauth2/` (authorize, token,
    # introspect, revoke, jwks, userinfo, par, device_authorization,
    # end_session), so narrowing the prefix loses nothing and hands
    # `/oauth2-clients` back to the SPA fallback in `location /`.
    #
    # `frontend/vite.config.ts` already guards this for the dev and
    # `vite preview` proxies with `^/oauth2(/|\?|$)` — which is why the bug was
    # invisible to the E2E suite until it was pointed at the production image.
    # Regression test: `frontend/e2e/matrix/spa-routing.spec.ts`.
    #
    # location blocks must re-declare security headers (nginx inherits headers from
    # the server block only when the location block sets no add_header directives;
    # adding proxy_set_header alone does NOT suppress header inheritance, but
    # explicit repetition prevents silent regressions on future header additions).
    location /oauth2/ {
        proxy_pass ${AXIAM_BACKEND_ORIGIN};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # A forwarded client certificate is only worth anything when the
        # forwarder verified it, and this one did not: nginx here terminates
        # server-auth TLS at most. Clearing it stops a client from asserting a
        # device identity by setting the header itself. The backend refuses it
        # anyway unless AXIAM__AUTH__TRUST_FORWARDED_CLIENT_CERT is on; this is
        # the other half of that defence, so neither has to be the only one.
        proxy_set_header X-Client-Certificate "";
        # Applied only when AXIAM_BACKEND_ORIGIN is https://; inert otherwise.
        proxy_ssl_server_name on;
        proxy_ssl_name ${AXIAM_BACKEND_SNI};
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate ${AXIAM_BACKEND_CA};
        proxy_ssl_protocols TLSv1.3;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'" always;
    }

    # SEC-016: Proxy OIDC/OAuth2 discovery endpoints (/.well-known/*) to the backend.
    location /.well-known {
        proxy_pass ${AXIAM_BACKEND_ORIGIN};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # A forwarded client certificate is only worth anything when the
        # forwarder verified it, and this one did not: nginx here terminates
        # server-auth TLS at most. Clearing it stops a client from asserting a
        # device identity by setting the header itself. The backend refuses it
        # anyway unless AXIAM__AUTH__TRUST_FORWARDED_CLIENT_CERT is on; this is
        # the other half of that defence, so neither has to be the only one.
        proxy_set_header X-Client-Certificate "";
        # Applied only when AXIAM_BACKEND_ORIGIN is https://; inert otherwise.
        proxy_ssl_server_name on;
        proxy_ssl_name ${AXIAM_BACKEND_SNI};
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate ${AXIAM_BACKEND_CA};
        proxy_ssl_protocols TLSv1.3;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'" always;
    }
}
