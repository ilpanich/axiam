# The placement decision, Live profile: AXIAM decides, per authentication
# (docker/docker-compose.radius-live.yml mounts this file over ../check-eap-tls).
# docs/pki/freeradius.md, "The decision per authentication".
#
# EAP-TLS has verified the certificate (chain to the tenant signing CA, CRL, and
# the `verify` hook that left its fingerprint behind). This server then asks
# AXIAM whether the device it belongs to is placed on this site, and copies the
# answer into the Access-Accept: only the attributes of the `axiam-radius-reply/1`
# dictionary, each in its dictionary shape and nothing else.
#
# The decision runs in `post-auth` of THIS virtual server, not of `default`: the
# attributes of the client certificate (TLS-Client-Cert-*) exist only while this
# server runs, and the reply attributes set here are the ones the NAS gets. A
# `reject` here is the Access-Reject ("Certificate rejected by the virtual
# server"), with no attribute and no reason on the wire.
#
# EVERY failure is a reject: AXIAM unreachable, a TLS or HTTP error, a status
# other than 2xx, a body that is not the allow this recipe knows. There is no
# fallback placement and no cached decision: only the token is cached, and a
# `401` from the decision drops it (one retry with a new token, never more).

server check-eap-tls {
	authorize {
		update control {
			Auth-Type := Accept
		}
	}

	post-auth {
		# FreeRADIUS evaluates a comparison against an attribute that does not
		# exist as false, whichever way it reads: "if (&X !~ /re/) { reject }"
		# does NOT reject when X is missing. Every attribute a check reads is
		# therefore given a value that matches nothing first, so a step that
		# fails to set one leaves it failing its check. The token's is `!`, which
		# its check refuses: `-` is a token character (#764).
		update control {
			Tmp-String-0 := "-"
			Tmp-String-1 := "-"
			Tmp-String-2 := "!"
			Tmp-String-3 := "-"
			Tmp-String-4 := "-"
			Tmp-String-5 := "-"
			Tmp-Integer-0 := 0
			Tmp-Integer-1 := 0
		}

		# 1. The site key, from this client's own configuration, and the
		#    fingerprint of the certificate EAP-TLS just verified.
		update control {
			Tmp-String-1 := "%{client:shortname}"
			Tmp-String-0 := "%{axiam_take:/bin/sh /etc/freeradius/axiam-live/axiam-live.sh take %{TLS-Client-Cert-Serial}}"
		}
		if (&control:Tmp-String-1 !~ /^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$/) {
			reject
		}
		if (&control:Tmp-String-0 !~ /^[0-9a-f]{64}$/) {
			reject
		}

		# 2. This server's own token: from the cache, else from AXIAM.
		#    Every call on axiam_token_cache is either read-only or a store with
		#    a negative TTL, so none can create an entry that does not hold a
		#    token this request fetched (#764). The read is ONE read-only call:
		#    rlm_cache (3.2.8, rlm_cache.c:485-493, 520-534) merges a live entry
		#    and answers `ok`, and on an absent one answers `notfound` and
		#    inserts nothing. A status probe followed by a plain call would
		#    leave a window between the two in which another thread's drop
		#    makes the plain call insert this request's sentinel.
		update control {
			Cache-Read-Only := yes
		}
		axiam_token_cache
		if (notfound) {
			axiam_token
			if (!(ok || updated)) {
				reject
			}
			update control {
				Tmp-String-4 := "%{reply:REST-HTTP-Body}"
			}
			update reply {
				REST-HTTP-Body !* ANY
				REST-HTTP-Status-Code !* ANY
			}
			if (&control:Tmp-String-4 !~ /"access_token"\s*:\s*"([A-Za-z0-9._~+\/=-]+)"/) {
				reject
			}
			update control {
				Tmp-String-2 := "%{1}"
				Tmp-Integer-1 := 1
			}
			# The entry lives for half the token's life.
			if (&control:Tmp-String-4 !~ /"expires_in"\s*:\s*([1-9][0-9]{2,5})/) {
				reject
			}
			#    A negative TTL expires whatever entry another thread stored
			#    meanwhile and inserts THIS request's token, so the token this
			#    authentication decides with when Tmp-Integer-1 is 1 is the one
			#    it fetched; a positive one would merge the other entry over it.
			update control {
				Cache-TTL := "%{expr:0 - %{1} / 2}"
			}
			axiam_token_cache
		}
		if (&control:Tmp-String-2 !~ /^[A-Za-z0-9._~+\/=-]+$/) {
			reject
		}

		# 3. The decision.
		update control {
			REST-HTTP-Header := "Authorization: Bearer %{control:Tmp-String-2}"
		}
		#    In post-auth rlm_rest answers EVERY 4xx with `invalid`, which ends a
		#    section at once; priority 1 lets this section carry on and look at the
		#    status. So every 4xx (a 400, 403 or 404 as much as a 401) continues
		#    below, and anything but a 401 is rejected by the status test there. A
		#    5xx or a transport failure keeps its own action and still ends the
		#    section as before.
		axiam_decide {
			invalid = 1
		}
		if (!(ok || updated)) {
			# A 401 says the token is no good to AXIAM now: the FreeRADIUS
			# certificate was revoked and re-issued, or AXIAM's signing key
			# rotated. Its cache entry is dropped at once, whatever follows, so it
			# is not served for the rest of its half life (#707). When the token
			# came from the cache, a new one is fetched and the decision asked
			# ONCE more; a token fetched a moment ago is not retried. A second
			# 401, a 403 and every other failure stay a reject.
			update control {
				Tmp-String-5 := "%{reply:REST-HTTP-Status-Code}"
			}
			update reply {
				REST-HTTP-Body !* ANY
				REST-HTTP-Status-Code !* ANY
			}
			if (&control:Tmp-String-5 !~ /^401$/) {
				reject
			}
			#    Cache-TTL 0 expires the entry; on an ABSENT entry rlm_cache
			#    (3.2.8) would instead insert this request's refused token, so the
			#    drop is read-only: a thread that finds the entry already dropped
			#    by another creates nothing (#720).
			update control {
				Cache-Status-Only !* ANY
				Cache-Read-Only := yes
				Cache-TTL := 0
			}
			axiam_token_cache
			if (&control:Tmp-Integer-1 != 0) {
				reject
			}
			update control {
				Tmp-String-2 := "!"
			}
			axiam_token
			if (!(ok || updated)) {
				reject
			}
			update control {
				Tmp-String-4 := "%{reply:REST-HTTP-Body}"
			}
			update reply {
				REST-HTTP-Body !* ANY
				REST-HTTP-Status-Code !* ANY
			}
			if (&control:Tmp-String-4 !~ /"access_token"\s*:\s*"([A-Za-z0-9._~+\/=-]+)"/) {
				reject
			}
			update control {
				Tmp-String-2 := "%{1}"
			}
			if (&control:Tmp-String-4 !~ /"expires_in"\s*:\s*([1-9][0-9]{2,5})/) {
				reject
			}
			#    A negative TTL expires whatever entry is there and inserts THIS
			#    request's token. A positive one would merge a concurrent thread's
			#    (refused) entry over the token just fetched (#720).
			update control {
				Cache-Read-Only !* ANY
				Cache-TTL := "%{expr:0 - %{1} / 2}"
			}
			axiam_token_cache
			if (&control:Tmp-String-2 !~ /^[A-Za-z0-9._~+\/=-]+$/) {
				reject
			}
			update control {
				REST-HTTP-Header := "Authorization: Bearer %{control:Tmp-String-2}"
			}
			axiam_decide
			if (!(ok || updated)) {
				reject
			}
		}
		update control {
			Tmp-String-3 := "%{reply:REST-HTTP-Body}"
		}
		update reply {
			REST-HTTP-Body !* ANY
			REST-HTTP-Status-Code !* ANY
		}

		# 4. The mapping. Anything but a well-formed allow of the one dictionary
		#    this recipe knows is a reject.
		if (&control:Tmp-String-3 !~ /^\s*\{\s*"allow"\s*:\s*true\s*,\s*"reply"\s*:\s*\{\s*"dictionary"\s*:\s*"axiam-radius-reply\/1"\s*,\s*"attributes"\s*:\s*\[/) {
			reject
		}

		#    The VLAN: all three or no placement.
		if (&control:Tmp-String-3 !~ /"name"\s*:\s*"Tunnel-Type"\s*,\s*"number"\s*:\s*64\s*,\s*"value"\s*:\s*13\s*,\s*"tag"\s*:\s*0\s*\}/) {
			reject
		}
		if (&control:Tmp-String-3 !~ /"name"\s*:\s*"Tunnel-Medium-Type"\s*,\s*"number"\s*:\s*65\s*,\s*"value"\s*:\s*6\s*,\s*"tag"\s*:\s*0\s*\}/) {
			reject
		}
		if (&control:Tmp-String-3 !~ /"name"\s*:\s*"Tunnel-Private-Group-Id"\s*,\s*"number"\s*:\s*81\s*,\s*"value"\s*:\s*"([1-9][0-9]{0,3})"\s*\}/) {
			reject
		}
		update control {
			Tmp-Integer-0 := "%{1}"
		}
		if (&control:Tmp-Integer-0 > 4094) {
			reject
		}
		update reply {
			Tunnel-Type:0 := VLAN
			Tunnel-Medium-Type:0 := IEEE-802
			Tunnel-Private-Group-Id:0 := "%{control:Tmp-Integer-0}"
		}

		#    The session bound: required, because it is the only bound on a
		#    placement that outlives the decision.
		if (&control:Tmp-String-3 !~ /"name"\s*:\s*"Session-Timeout"\s*,\s*"number"\s*:\s*27\s*,\s*"value"\s*:\s*([1-9][0-9]{2,8})\s*\}/) {
			reject
		}
		update reply {
			Session-Timeout := "%{1}"
		}
		if (&control:Tmp-String-3 !~ /"name"\s*:\s*"Termination-Action"\s*,\s*"number"\s*:\s*29\s*,\s*"value"\s*:\s*([01])\s*\}/) {
			reject
		}
		update reply {
			Termination-Action := "%{1}"
		}

		#    The optional ones. When AXIAM names one it must be well formed:
		#    an ACL or a timeout silently dropped would widen the placement.
		if (&control:Tmp-String-3 =~ /"name"\s*:\s*"Idle-Timeout"/) {
			if (&control:Tmp-String-3 !~ /"name"\s*:\s*"Idle-Timeout"\s*,\s*"number"\s*:\s*28\s*,\s*"value"\s*:\s*([1-9][0-9]{1,8})\s*\}/) {
				reject
			}
			update reply {
				Idle-Timeout := "%{1}"
			}
		}
		if (&control:Tmp-String-3 =~ /"name"\s*:\s*"Filter-Id"/) {
			if (&control:Tmp-String-3 !~ /"name"\s*:\s*"Filter-Id"\s*,\s*"number"\s*:\s*11\s*,\s*"value"\s*:\s*"([A-Za-z0-9][A-Za-z0-9._-]{0,62})"\s*\}/) {
				reject
			}
			update reply {
				Filter-Id := "%{1}"
			}
		}
		if (&control:Tmp-String-3 =~ /"name"\s*:\s*"Service-Type"/) {
			if (&control:Tmp-String-3 !~ /"name"\s*:\s*"Service-Type"\s*,\s*"number"\s*:\s*6\s*,\s*"value"\s*:\s*2\s*\}/) {
				reject
			}
			update reply {
				Service-Type := Framed-User
			}
		}

		# Nothing else in the body is read, so nothing else can reach the reply.
	}
}
