# Run 7 image pins — every image except AXIAM's, by the digest runs 6, 6b and 6c
# pulled and recorded (results/run6b/provenance/images.txt and
# results/run6c/provenance/images.txt), so the competitors and the datastore are
# byte for byte what the earlier rounds measured, and only AXIAM changes.
#
# Sourced by run7.sh before `runner/pull-pinned-images.sh`, which pulls these,
# re-reads each digest from the registry answer and writes the run's own
# images.txt. A pin that no longer resolves fails the pull loudly, before any
# k6 time is spent.
#
# AXIAM is NOT pinned here: pull-pinned-images.sh derives
# ghcr.io/ilpanich/axiam/server:<workspace version> (1.4.0) and records the
# digest it resolves to.

export BENCH_KEYCLOAK_IMAGE="quay.io/keycloak/keycloak@sha256:3f3c5f8e03c614774b4bd9173b88391fefa4153bfc010d8012d59ad825377332"   # 26.8.1
export BENCH_ZITADEL_IMAGE="ghcr.io/zitadel/zitadel@sha256:a586456a208e0db4c633db0ba43c427c24b37846138b8b13ff16ad8e003a18d3"      # v4.19.5
export BENCH_AUTHENTIK_IMAGE="ghcr.io/goauthentik/server@sha256:602227a86455d6772e3d16b7d852713c4f864f40df5df894abd1285bb53979a5" # 2026.8.5
export BENCH_PG_IMAGE="postgres@sha256:1d5b02d3a9941fbd52437db4107f8c52d6297dac553ca1e5c299ebb3756b4857"                         # 16-alpine
export BENCH_RABBITMQ_IMAGE="rabbitmq@sha256:fa8746831e6096fc9111365960e1e56871dd5d0d362af67fd48bd8d156aba818"                   # 4-management-alpine

# SurrealDB 4.0.1 — the supported server, and still the newest release on
# 2026-11-28 (surrealdb/surrealdb#7667 and #7716 open). Same digest as runs 6/6b.
export BENCH_SURREALDB_IMAGE="surrealdb/surrealdb@sha256:408eb8e5c9436670525e2bc2634b1e50ba74ce1b447eaf0094c35f73b67f9cb6"

# SurrealDB 3.3.5 — only for the optional `surreal335` pass (unsupported,
# benchmark-only; runbook §14 and §15). Same digest as run 6c.
RUN7_SURREALDB_335="surrealdb/surrealdb@sha256:3db515b88e79737aa828c05fbf1515748004ba57495ff89a013851cc3f1ad4b9"
