# Every version this deployment pins, in one file.
#
# Sourced by the scripts in this directory and quoted by the OpenTofu stages.
# A plan that installs "latest" is not reproducible next month, and on a single
# node there is nothing to roll back to.
#
# Each of these was confirmed to exist and to publish a linux/arm64 artifact on
# 2026-09-16. Bumping one is a deliberate act: read that project's changelog,
# change it here, and re-run the stage that consumes it.

# k3s. A patch release of the PREVIOUS minor, deliberately — the `.0` of a new
# Kubernetes minor on the only node you have is not where to discover a
# regression. Check https://github.com/k3s-io/k3s/releases for the channel you
# want; `INSTALL_K3S_VERSION` takes this string verbatim.
K3S_VERSION="v1.36.1+k3s1"

# kubectl, matched to the server minor. The supported skew is ±1 minor, so this
# does not have to be exact — matching it means `kubectl explain` describes the
# API server you actually have.
KUBECTL_VERSION="v1.36.1"

# OpenTofu. Terraform works too; nothing in `tofu/` uses OpenTofu-only syntax
# except `encryption.tofu`, whose `.tofu` extension Terraform ignores by design.
TOFU_VERSION="1.12.6"

# Helm CLI. OPTIONAL — the OpenTofu `helm` provider talks to chart repositories
# itself and does not shell out to this binary. It is installed for `helm
# template` when you want to see what a chart renders before applying it, and
# the install step is allowed to fail without failing the script.
HELM_VERSION="v3.16.4"

# cert-manager. The chart version and the app version are the same string.
CERT_MANAGER_VERSION="v1.21.2"

# ingress-nginx Helm chart (not the controller image — the chart pins that).
INGRESS_NGINX_CHART_VERSION="4.15.1"
